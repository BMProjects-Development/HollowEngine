@import "hollowengine:ui/styles/theme.hss";

.image-editor-root {
    gap: 5px;
    padding: 5px;
    background: $bg-raised;
}

.image-editor-tool {
    height: fit;
    padding: 3px 5px;
}

.image-editor-canvas-scroll {
    background: $bg-window;
    @apply $thin-scroll;
}

.image-editor-sidebar {
    gap: 7px;
    padding: 8px 10px 8px 12px;
    background: $bg-hover;
    border-radius: $radius;
    @apply $thin-scroll;
}

.image-editor-sidebar-title {
    height: fit;
    margin: 4px 0px 0px 0px;
    foreground: $caret;
}

.image-editor-info {
    height: fit;
    foreground: $text-soft;
    text-wrap: true;
}
