@import "hollowengine:ui/styles/theme.hss";

.asset-manager-root {
    margin: 1px;
    padding: 0px;
    gap: 0px;
    background: $bg-field;
    clip: true;
}

.asset-sidebar {
    min-width: 170px;
    gap: 3px;
    padding: 3px;
    background: $bg-raised;
}

.asset-tabs {
    width: 100%;
    height: fit;
    gap: 1px;
    padding: 1px;
    background: $bg-field;
    border-radius: $radius;
}

.asset-tab {
    align-items: center center;
    border-radius: $radius-small;
    foreground: $text-muted;
    background: transparent;
    transition: all 120ms ease-out;
}

.asset-tab:hover {
    background: $bg-hover;
}

.asset-tab.selected {
    foreground: $caret;
    background: $row-selected;
}

.asset-tab-label {
    height: fit;
    font-size: $font-size-small;
    wrap: false;
}

.asset-splitter {
    background: $bg-pressed;
    transition: background 100ms ease-out;
}

.asset-splitter:hover {
    background: $accent;
}

.asset-content {
    background: $bg-field;
}

.asset-toolbar {
    width: 100%;
    min-height: 22px;
    padding: 2px 5px;
    gap: 5px;
    align-items: start center;
    background: $bg-hover;
    border-bottom: 1px $bg-pressed;
}

.asset-breadcrumb {
    height: fit;
    foreground: $text-strong;
    font-size: $font-size;
    text-overflow: dots;
}

.asset-count {
    width: fit;
    foreground: $text-faint;
    font-size: $font-size-small;
    wrap: false;
}

.asset-recipe-filter {
    min-width: 78px;
    min-height: 16px;
    padding: 1px 4px;
    font-size: $font-size-small;
}

.asset-refresh {
    size: 15px 15px;
    padding: 0px;
    transition: background 100ms ease-out, rotate 240ms ease-out;
}

.asset-refresh.loading {
    rotate: 0 0 180;
}

.asset-refresh .button-icon {
    size: 9px 9px;
}

.asset-grid-scroll {
    width: 100%;
    padding: 6px;
    @apply $thin-scroll;
}

.asset-grid {
    align-items: start start;
}

.asset-grid.justified {
    align-items: space-between start;
}

.asset-tile {
    size: 100% 100%;
    padding: 3px;
    gap: 2px;
    align-items: center start;
    border: 1px transparent;
    border-radius: $radius;
    background: transparent;
    transition: all 100ms ease-out;
}

.asset-tile:hover {
    background: $bg-hover;
    border: 1px $border;
}

.asset-tile.selected {
    background: $row-selected;
    border: 1px $accent;
}

.asset-preview {
    size: 62px 55px;
    align-items: center center;
    background: $bg-window;
    border: 1px $bg-pressed;
    border-radius: $radius;
    clip: true;
}

/* The folder carries its own color, the same as in the project tree. */
.asset-folder-icon {
    size: 38px 38px;
    tint: $white;
}

.asset-file-icon {
    size: 28px 28px;
}

.asset-tile-name {
    align: center start;
    foreground: $text-strong;
    font-size: $font-size-small;
    wrap: false;
    text-overflow: dots;
}

.asset-pack-name {
    align: center start;
    foreground: $text-faint;
    font-size: 7px;
    text-overflow: dots;
}

.asset-message {
    align-items: center center;
}

.asset-message-text {
    max-width: 280px;
    height: fit;
    foreground: $text-muted;
    font-size: $font-size;
    align: center center;
}

.asset-filter-icon, .asset-filter-close .button-icon {
    size: 11px 11px;
    tint: $text-soft;
}

.asset-filter-input {
    min-height: 17px;
    padding: 1px 2px;
    font-size: $font-size;
    caret-color: $caret;
    selection-color: $selection;
}

.asset-filter-close:hover {
    tint: $white;
}
