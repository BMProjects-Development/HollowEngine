@import "hollowengine:ui/styles/theme.hss";

/* The shader graph editor: nodes with a title bar in the color of their category, pins in the color
   of what they carry, filled once something is linked to them, and fields to edit values in place.
   A node has no frame; it is told apart by its title bar and, when picked, by a ring around it. */

$node-bg: #252525;
$node-field: #212121;
$node-line: alpha(#FFFFFF, 0.1);
$node-divider: alpha(#000000, 0.2);
$node-radius: 8px;
$node-field-radius: 5px;

/* The outline of a title bar: lighter than its color along the top and the sides, darker along the bottom.
   CSS gradient angles run from the top clockwise, so to bottom is 180deg. */
$head-light: alpha(#FFFFFF, 0.14);
$head-dark: alpha(#000000, 0.28);

$category-input: #BF8246;
$category-math: #3B8950;
$category-vector: #3B8950;
$category-uv: #3E86C4;
$category-normal: #3E86C4;
$category-texture: #C067A4;
$category-procedural: #5F59B1;
$category-output: #CF5E54;

.graph-node.sg-node {
    background: $node-bg;
    border: 0px $node-line;
    border-radius: $node-radius;
    shadow: 0px 3px 10px 0px $shadow;
}

.graph-node.sg-node.selected {
    shadow: 0px 3px 10px 0px $shadow, 0px 0px 0px 1.5px $accent;
}

.graph-node.sg-node.error {
    shadow: 0px 3px 10px 0px $shadow, 0px 0px 0px 1.5px $danger;
}

.graph-node.sg-node.collapsed {
    opacity: 0.65;
}

.sg-node-head {
    padding: 0px 10px;
    gap: 5px;
    background: $category-math;
    border: 1px linear-gradient(to bottom, $head-light 0%, $head-light 96.875%, $head-dark 96.875%, $head-dark 100%);
    border-radius: $node-radius;
}

/* Squares off the bottom corners of an open node's title bar, and outlines its sides again. */
.sg-node-head-flat {
    background: $category-math;
}

.sg-node-head-edge {
    background: $head-light;
}

.sg-input .sg-node-head, .sg-input .sg-node-head-flat { background: $category-input; }
.sg-vector .sg-node-head, .sg-vector .sg-node-head-flat { background: $category-vector; }
.sg-uv .sg-node-head, .sg-uv .sg-node-head-flat { background: $category-uv; }
.sg-normal .sg-node-head, .sg-normal .sg-node-head-flat { background: $category-normal; }
.sg-texture .sg-node-head, .sg-texture .sg-node-head-flat { background: $category-texture; }
.sg-procedural .sg-node-head, .sg-procedural .sg-node-head-flat { background: $category-procedural; }
.sg-output .sg-node-head, .sg-output .sg-node-head-flat { background: $category-output; }

.sg-node-divider {
    background: $node-divider;
}

.sg-node-icon {
    size: 15px 15px;
}

.sg-node-head .sg-node-title {
    font-size: 12px;
    foreground: $white;
    text-wrap: false;
    text-overflow: dots;
}

/* Collapses the node; the arrow points up while it is open. */
.sg-node-toggle {
    size: 16px 16px;
    align-items: center center;
    border-radius: $radius;
    cursor: hand;
    transition: background 110ms ease-out;
}

.sg-node-toggle:hover {
    background: alpha(#FFFFFF, 0.16);
}

.sg-node-arrow {
    size: 7px 5px;
    transform: rotate(180deg);
}

.collapsed .sg-node-arrow {
    transform: rotate(0deg);
}

.sg-node-row {
    gap: 6px;
}

.sg-pin-label {
    font-size: 11px;
    foreground: $white;
    text-wrap: false;
    text-overflow: dots;
}

/* What an unlinked input reads instead of a value, such as the UV. */
.sg-pin-hint {
    font-size: 9px;
    foreground: $text-faint;
    text-wrap: false;
}

/* The name of a value, which a drag along changes it by. */
.sg-scrub {
    cursor: ew-resize;
    transition: foreground 110ms ease-out;
}

.sg-scrub:hover {
    foreground: $text-strong;
}

.sg-fields {
    gap: 4px;
}

.sg-field {
    padding: 3px 6px;
    background: $node-field;
    border: 1px $node-line;
    border-radius: $node-field-radius;
    foreground: #E9E9E9;
    font-family: $font;
    font-size: 9px;
    caret-color: $caret;
    selection-color: $selection;
    text-shadow: none;
    transition: border 110ms ease-out;
}

.sg-field:hover {
    border-color: $border;
}

.sg-field:focus {
    border-color: $accent;
}

/* An expression is code. */
.sg-expression {
    font-family: $font-code;
    font-size: 9px;
}

/* What a choice is set to; a press opens its values. */
.sg-chip {
    padding: 3px 6px;
    background: $node-field;
    border: 1px $node-line;
    border-radius: $node-field-radius;
    foreground: $white;
    font-family: $font;
    font-size: 9px;
    text-wrap: false;
    text-overflow: dots;
    cursor: hand;
    transition: border 110ms ease-out, background 110ms ease-out;
}

.sg-chip:hover {
    background: $bg-hover;
    border-color: $border;
}

.sg-toggle {
    gap: 6px;
    cursor: hand;
}

.sg-checkbox {
    size: 10px 10px;
    checkbox-active: $accent;
    checkbox-mark: $white;
}

.sg-node-preview {
    background: $bg-window;
    border-radius: $node-field-radius;
}

/* A dot on the edge of the node: a ring while nothing is linked, filled once something is. */
.sg-pin {
    background: $node-bg;
    border: 1.5px #A5ABC0;
    border-radius: 4.5px;
    shadow: 0px 1px 3px 0px alpha(#000000, 0.55);
    cursor: hand;
    transition: background 150ms ease-out;
}

.sg-pin:hover {
    background: $white;
}

.sg-pin.sg-type-float { border-color: #A5ABC0; }
.sg-pin.sg-type-vec2 { border-color: #44BC74; }
.sg-pin.sg-type-vec3 { border-color: #F0CF60; }
.sg-pin.sg-type-vec4 { border-color: #C774AA; }
.sg-pin.sg-type-texture { border-color: #C9874A; }

.sg-pin.connected.sg-type-float { background: #A5ABC0; }
.sg-pin.connected.sg-type-vec2 { background: #44BC74; }
.sg-pin.connected.sg-type-vec3 { background: #F0CF60; }
.sg-pin.connected.sg-type-vec4 { background: #C774AA; }
.sg-pin.connected.sg-type-texture { background: #C9874A; }

/* A texture is a reference to an object rather than a value, which the design draws as a square. */
.sg-pin.sg-type-texture {
    border-radius: 2px;
}

/* A number of a node keeps the node's field look; its parts bring their own room. */
.number-field.sg-field { padding: 0px; }

.number-field.sg-field .number-field-frame { size: 100% 100%; }

.number-field.sg-field.editing { padding: 1px 4px; }

.sg-swatch {
    border: 1px alpha(#FFFFFF, 0.28);
    border-radius: $node-field-radius;
    cursor: hand;
    transition: border 110ms ease-out;
}

.sg-swatch:hover {
    border-color: $border-strong;
}

.sg-color-popup {
    padding: 8px;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius;
    shadow: 1px 1px 3px 0px $shadow;
    font-family: $font;
    font-size: $font-size;
}

.sg-color-popup-body {
    gap: 6px;
}

/* A reroute: a dot in the color of what passes through it, ringed when it is picked. */
.graph-node.sg-reroute {
    background: #A5ABC0;
    border: 1.5px alpha(#000000, 0.35);
    border-radius: 6px;
    shadow: 0px 1px 3px 0px alpha(#000000, 0.55);
}

.graph-node.sg-reroute:hover {
    border-color: $white;
}

.graph-node.sg-reroute.selected {
    shadow: 0px 1px 3px 0px alpha(#000000, 0.55), 0px 0px 0px 1.5px $accent;
}

.graph-node.sg-reroute.sg-type-vec2 { background: #44BC74; }
.graph-node.sg-reroute.sg-type-vec3 { background: #F0CF60; }
.graph-node.sg-reroute.sg-type-vec4 { background: #C774AA; }
.graph-node.sg-reroute.sg-type-texture { background: #C9874A; border-radius: 2px; }

/* A collapsed group: a node whose title bar takes the group's color, and whose rows only name pins. */
.graph-node.sg-group-card .sg-node-title {
    foreground: $white;
}
