@import "hollowengine:ui/styles/theme.hss";

/* Sits in `.ide-file-panel`, which gives it the rounded panel of the text editor beside it. */
.sounds-editor-root {
    gap: 6px;
    padding: 6px;
}

.sounds-editor-toolbar {
    size: 100% 26px;
    gap: 8px;
    padding: 0px 4px;
}

.sounds-editor-title {
    height: fit;
    foreground: $caret;
    font-size: 12px;
    text-wrap: false;
}

.sounds-editor-status {
    height: fit;
    foreground: $success;
    font-size: 10px;
    text-wrap: false;
}

.sounds-editor-status.dirty {
    foreground: $accent;
}

.sounds-editor-status-dot {
    size: 6px 6px;
    border-radius: $radius-small;
    background: $success;
    transition: background 150ms ease-out;
}

.sounds-editor-status-dot.dirty {
    background: $accent;
}

.sounds-editor-list {
    gap: 5px;
    padding: 6px;
    background: $bg-panel;
    border-radius: $radius;
}

.sounds-editor-list-scroll {
    gap: 2px;
    @apply $thin-scroll;
}

.sounds-editor-detail {
    gap: 7px;
    padding: 8px 10px;
    background: $bg-panel;
    border-radius: $radius;
    @apply $thin-scroll;
}

.sounds-editor-event {
    padding: 0px 4px 0px 8px;
    gap: 4px;
    background: transparent;
    foreground: $text;
    border-radius: $radius;
    transition: background 120ms ease-out, foreground 120ms ease-out;
}

.sounds-editor-event:hover {
    background: alpha($white, 0.07);
    foreground: $white;
}

.sounds-editor-event.selected {
    background: $row-selected;
    foreground: $white;
}

.sounds-editor-event-label {
    height: fit;
    align: start center;
    text-wrap: false;
}

.sounds-editor-event-count {
    height: fit;
    foreground: $text-muted;
    font-size: 9px;
    text-wrap: false;
}

.sounds-editor-empty,
.sounds-editor-placeholder {
    height: fit;
    padding: 8px 4px;
    foreground: $text-muted;
    text-wrap: true;
}

.sounds-editor-labeled {
    size: 100% fit;
    gap: 2px;
}

.sounds-editor-section {
    margin: 4px 0px 0px 0px;
}

.sounds-editor-section-title {
    height: fit;
    foreground: $caret;
    text-wrap: false;
}

.sounds-editor-label {
    height: fit;
    foreground: $text-soft;
    font-size: 10px;
    text-wrap: false;
}

.sounds-editor-value {
    height: fit;
    foreground: $text;
    font-size: 10px;
    align: end center;
    text-wrap: false;
}

.sounds-editor-search,
.sounds-editor-field {
    padding: 3px 5px;
    background: $bg-field;
    border: 1px $divider;
    border-radius: $radius-small;
    foreground: $text-strong;
    caret-color: $caret;
    selection-color: $selection;
}

.sounds-editor-sound-card {
    size: 100% fit;
    gap: 5px;
    padding: 7px;
    background: $bg-field;
    border-radius: $radius;
}

