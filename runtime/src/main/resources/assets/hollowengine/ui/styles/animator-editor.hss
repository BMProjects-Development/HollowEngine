@import "hollowengine:ui/styles/theme.hss";

.animator-button {
    size: 100% 22px;
    align-items: center;
    justify-content: center;
    padding: 4px 6px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-icon-button {
    padding: 3px;
    background: transparent;
    border-radius: $radius-small;
    tint: $text-soft;
    cursor: hand;
    transition: background 110ms ease-out, tint 110ms ease-out;
}

.animator-icon-button:hover {
    background: $bg-hover;
    tint: $white;
}

.animator-icon-button.active {
    background: $bg-selected;
    tint: $accent;
}

.animator-icon-button.active:hover {
    background: $bg-selected;
}

.viewport-toolbar {
    padding: 2px;
    gap: 1px;
    background: alpha($bg-window, 0.86);
    border-radius: $radius;
}

.rig-transform-hint {
    padding: 2px 6px;
    background: alpha($bg-window, 0.86);
    border-radius: $radius-small;
    foreground: $text-strong;
    font-size: $font-size;
}

.animator-pill {
    padding: 5px 3px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-pill:hover {
    background: $bg-pressed;
    border-color: $text-strong;
}

.animator-pill.active {
    background: $accent-soft;
    border-color: alpha($white, 0.1);
}

.animator-pill-label {
    font-size: 8px;
    foreground: $text-strong;
    text-wrap: false;
}

/* A state of a controller graph; the frame is the graph node's. */
.animator-state {
    padding: 6px 8px;
    gap: 5px;
    justify-content: center;
}

.animator-state.entry {
    border-color: $success;
}

.animator-state.any-state {
    border-color: #9E85EB;
}

/* After the kinds: a selected entry state reads as selected. */
.animator-state.selected {
    border-color: $accent;
}

.animator-state-row {
    gap: 5px;
}

.animator-state-icon {
    size: 10px 10px;
    tint: $text-soft;
}

.animator-state.any-state .animator-state-icon {
    tint: #9E85EB;
}

.animator-state.any-state .graph-node-title {
    foreground: #9E85EB;
}

.animator-play-mode {
    padding: 1px 4px;
    font-size: 7px;
    foreground: $text-soft;
    background: $bg-field;
    border: 1px $border;
    border-radius: $radius-small;
    text-wrap: false;
}

.animator-entry-badge {
    size: 10px 10px;
    tint: $success;
}

.animator-empty-title {
    font-size: $font-size-title;
    foreground: $text;
}

.animator-empty-hint {
    font-size: $font-size;
    foreground: $text-muted;
}
