@import "hollowengine:ui/styles/theme.hss";

.animator-button {
    size: 100% 22px;
    align-items: center;
    justify-content: center;
    padding: 4px 6px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-icon-button {
    padding: 3px;
    background: transparent;
    border-radius: $radius-small;
    tint: $text-soft;
    cursor: hand;
    transition: background 110ms ease-out, tint 110ms ease-out;
}

.animator-icon-button:hover {
    background: $bg-hover;
    tint: $white;
}

.animator-icon-button.active {
    background: $bg-selected;
    tint: $accent;
}

.animator-icon-button.active:hover {
    background: $bg-selected;
}

.viewport-toolbar {
    padding: 2px;
    gap: 1px;
    background: alpha($bg-window, 0.86);
    border-radius: $radius;
}

.rig-transform-hint {
    padding: 2px 6px;
    background: alpha($bg-window, 0.86);
    border-radius: $radius-small;
    foreground: $text-strong;
    font-size: $font-size;
}

.animator-pill {
    padding: 5px 3px;
    background: $bg-selected;
    border: 1px alpha($white, 0.1);
    border-radius: $radius-small;
    cursor: hand;
    transition: background 250ms ease-out, border-color 250ms ease-out;
}

.animator-pill:hover {
    background: $bg-pressed;
    border-color: $text-strong;
}

.animator-pill.active {
    background: $accent-soft;
    border-color: alpha($white, 0.1);
}

.animator-pill-label {
    font-size: 8px;
    foreground: $text-strong;
    text-wrap: false;
}

/* A state of a controller graph; the frame is the graph node's. */
.animator-state {
    padding: 6px 8px;
    gap: 5px;
    justify-content: center;
}

.animator-state.entry {
    border-color: $success;
}

.animator-state.any-state {
    border-color: #9E85EB;
}

/* After the kinds: a selected entry state reads as selected. */
.animator-state.selected {
    border-color: $accent;
}

.animator-state-row {
    gap: 5px;
}

.animator-state-icon {
    size: 10px 10px;
    tint: $text-soft;
}

.animator-state.any-state .animator-state-icon {
    tint: #9E85EB;
}

.animator-state.any-state .graph-node-title {
    foreground: #9E85EB;
}

.animator-play-mode {
    padding: 1px 4px;
    font-size: 7px;
    foreground: $text-soft;
    background: $bg-field;
    border: 1px $border;
    border-radius: $radius-small;
    text-wrap: false;
}

.animator-entry-badge {
    size: 10px 10px;
    tint: $success;
}

.animator-empty-title {
    font-size: $font-size-title;
    foreground: $text;
}

.animator-empty-hint {
    font-size: $font-size;
    foreground: $text-muted;
}

/* The diagram of a blend state in the inspector: clips are round, the checked point is a square crosshair. */
.animator-blend-point {
    background: $text-faint;
    border: 1px alpha($white, 0.35);
    border-radius: 5px;
    transition: background 110ms ease-out, border-color 110ms ease-out;
}

.animator-blend-point:hover {
    background: $text-strong;
    border-color: $white;
}

.animator-blend-point.active {
    background: $success;
}

.animator-blend-halo {
    background: alpha($success, 0.18);
    border-radius: 20px;
}

.animator-blend-label {
    font-size: 7px;
    foreground: $text-muted;
    text-wrap: false;
}

.animator-blend-label.active {
    foreground: $text-strong;
}

.animator-blend-probe {
    border: 1px $accent;
    border-radius: 1px;
}

.animator-blend-tick {
    font-size: 7px;
    foreground: $text-faint;
    text-wrap: false;
}

.animator-blend-tick.center {
    text-align: center;
}

.animator-blend-tick.right {
    text-align: right;
}

.animator-blend-readout {
    gap: 5px;
    align-items: center;
    padding: 2px 0;
}

.animator-blend-readout-mark {
    size: 7px 7px;
    border: 1px $accent;
    border-radius: 1px;
}

.animator-blend-readout-title {
    font-size: 8px;
    foreground: $text-soft;
}

.animator-blend-readout-value {
    font-size: 8px;
    foreground: $accent;
    text-wrap: false;
}

.animator-blend-label.leftward {
    text-align: right;
}

.animator-blend-label-position {
    foreground: $text-faint;
}

/* The range of the diagram: fields under the ends of a line, or a table under a plane. */
.animator-blend-line-range {
    padding: 0 0 4px 0;
}

.animator-blend-plane-range {
    gap: 3px;
    padding: 2px 0 6px 0;
}

.animator-blend-range-row {
    gap: 5px;
    align-items: center;
}

.animator-blend-range-axis {
    size: 10px fit;
    font-size: 8px;
    foreground: $text-soft;
}

.animator-blend-range-word {
    font-size: 8px;
    foreground: $text-muted;
    text-wrap: false;
}

/* A clip's folding section: where it stands and its weight sit in the heading. */
.animator-blend-heading-position {
    font-size: 8px;
    foreground: $text-faint;
    text-wrap: false;
}

.animator-blend-weight {
    text-align: right;
    font-size: 8px;
    foreground: $text-soft;
    text-wrap: false;
}

.animator-blend-coordinates {
    gap: 6px;
}
