@import "hollowengine:ui/styles/theme.hss";

.ee-root {
    size: fill fill;
    gap: 6px;
    padding: 6px;
    background: alpha($bg-window, 0.94);
}

/* ---- preview ---- */

.ee-viewport {
    grow: 1;
    size: 0px 100%;
    min-size: 0px 0px;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    clip: true;
}

.ee-viewport-title {
    align: center start;
    margin: 8px;
    padding: 4px 10px;
    gap: 1px;
    size: fit fit;
    max-size: 70% fit;
    layer: 1000;
    align-items: center center;
    background: alpha($bg-field, 0.9);
    border-radius: $radius-large;
    border: 1px $bg-selected;
    backdrop-filter: blur(9px);
}

.ee-title {
    size: fit fit;
    foreground: $text-strong;
    font-size: 12px;
    wrap: false;
    text-overflow: dots;
}

.ee-subtitle {
    size: fit fit;
    foreground: $text-muted;
    font-size: 9px;
    wrap: false;
    text-overflow: dots;
}

.ee-toolbar {
    align: start start;
    margin: 8px;
    gap: 5px;
    size: fit fit;
    layer: 1000;
}

.ee-chip {
    size: 26px 26px;
    align-items: center center;
    background: alpha($bg-raised, 0.82);
    border-radius: $radius-large;
    border: 1px $bg-selected;
    hoverable: true;
    clickable: true;
    transition: background 140ms ease-out, border 140ms ease-out;
    backdrop-filter: blur(9px);
}

.ee-chip:hover { background: $bg-hover; }

.ee-chip.selected {
    background: $row-selected;
    border: 1px $accent;
}

.ee-chip-icon {
    size: 15px 15px;
    tint: $text;
}

.ee-chip.selected .ee-chip-icon { tint: $bg-panel; }

.ee-stats {
    align: end start;
    margin: 8px;
    padding: 7px 9px;
    gap: 3px;
    size: fit fit;
    min-size: 150px 0px;
    layer: 1000;
    background: alpha($bg-raised, 0.86);
    border-radius: $radius-large;
    border: 1px $bg-selected;
    backdrop-filter: blur(9px);
}

.ee-stat-row {
    size: 100% fit;
    gap: 10px;
    align-items: start center;
}

.ee-stat-label {
    size: fit fit;
    foreground: $text-muted;
    font-size: 9px;
    wrap: false;
}

.ee-stat-value {
    size: fit fit;
    foreground: $accent;
    font-size: 9px;
    wrap: false;
}

/* ---- splitter ---- */

.ee-splitter {
    size: 5px 100%;
    background: transparent;
    border-radius: $radius-small;
    hoverable: true;
    transition: background 140ms ease-out;
}

.ee-splitter:hover { background: $accent; }
.ee-splitter:dragging { background: $accent; }

/* ---- sidebar ---- */

.ee-sidebar {
    min-size: 240px 0px;
    gap: 6px;
    padding: 8px;
    background: $bg-raised;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    clip: true;
}

.ee-header {
    size: 100% fit;
    min-height: 22px;
    gap: 6px;
    align-items: start center;
}

.ee-header-title {
    size: fit fit;
    foreground: $text;
    font-size: 11px;
    wrap: false;
    text-overflow: dots;
}

.ee-tabs {
    size: 100% fit;
    gap: 4px;
}

.ee-tab {
    size: fit fit;
    min-height: 24px;
    padding: 4px 8px;
    align-items: center center;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    hoverable: true;
    clickable: true;
    transition: background 140ms ease-out, border 140ms ease-out;
}

.ee-tab:hover { background: $bg-hover; }

.ee-tab.active {
    background: $row-selected;
    border: 1px $accent;
}

.ee-tab-label {
    size: fit fit;
    foreground: $text;
    font-size: 9px;
    wrap: false;
}

.ee-tab.active .ee-tab-label { foreground: $accent; }

.ee-search {
    size: 100% fit;
    min-height: 24px;
    gap: 6px;
    padding: 2px 6px;
    align-items: start center;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
}

.ee-search-icon {
    size: 12px 12px;
    tint: $text-muted;
}

.ee-sidebar-body {
    width: 100%;
    gap: 6px;
}

/* ---- component card ---- */

.ee-card {
    size: 100% fit;
    gap: 5px;
    padding: 7px;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
}

.ee-card.virtual { border: 1px $bg-selected; }

.ee-card-head {
    size: 100% fit;
    min-height: 18px;
    gap: 6px;
    align-items: start center;
    hoverable: true;
    clickable: true;
}

.ee-card-icon {
    size: 13px 13px;
    tint: $accent;
}

.ee-card-title {
    size: fit fit;
    foreground: $text;
    font-size: 10px;
    wrap: false;
    text-overflow: dots;
}

.ee-badge {
    size: fit fit;
    foreground: $text-muted;
    font-size: 8px;
    padding: 1px 5px;
    background: alpha($bg-selected, 0.5);
    border-radius: $radius;
    wrap: false;
}

.ee-card-remove .button-icon { tint: $danger; }

.ee-card-body {
    size: 100% fit;
    gap: 7px;
}

/* ---- footer / add component ---- */

.ee-footer {
    size: 100% fit;
    gap: 6px;
}

.ee-add-panel {
    size: 100% fit;
    gap: 5px;
    padding: 6px;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
}

.ee-add-list {
    width: 100%;
    gap: 2px;
}

.ee-add-row {
    size: 100% fit;
    gap: 6px;
    padding: 4px 5px;
    align-items: start center;
    border-radius: $radius;
    hoverable: true;
    clickable: true;
    transition: background 140ms ease-out;
}

.ee-add-row:hover { background: $bg-hover; }

.ee-add-icon {
    size: 13px 13px;
    tint: $text-muted;
}

.ee-add-label {
    size: fit fit;
    foreground: $text;
    font-size: 9px;
    wrap: false;
    text-overflow: dots;
}

.ee-add-id {
    size: fit fit;
    foreground: $border-strong;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

/* ---- scripts tab ---- */

.ee-section-title {
    size: 100% fit;
    foreground: $accent;
    font-size: 10px;
    margin: 4px 0px 0px 0px;
}

.ee-script-icon {
    size: 14px 14px;
    tint: $text-muted;
}

.ee-script-name {
    size: fit fit;
    foreground: $text;
    font-size: 9px;
    wrap: false;
    text-overflow: dots;
}

.ee-script-path {
    size: fit fit;
    foreground: $border-strong;
    font-size: 8px;
    wrap: false;
    text-overflow: dots;
}

/* ---- dialogs (asset picker, inventory) ---- */

.ee-dialog {
    gap: 8px;
    padding: 12px;
    background: $bg-raised;
    border-radius: $radius-large;
    border: 1px $border-strong;
    shadow: 2px 2px 10px 0px $shadow;
}

.ee-dialog-head {
    size: 100% fit;
    gap: 8px;
    align-items: start center;
}

.ee-dialog-title {
    size: fit fit;
    foreground: $text-strong;
    font-size: 11px;
    wrap: false;
    text-overflow: dots;
}

.ee-asset-tree {
    width: 100%;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    padding: 4px;
}

/* ---- slots ---- */

.ee-slots {
    size: 100% fit;
}

.ee-slot-groups {
    size: fit fit;
    gap: 6px;
    align: center start;
}

.slot {
    background: $bg-window;
    border-radius: $radius-small;
    border: 1px $bg-selected;
    transition: background 140ms ease-out, border 140ms ease-out;
}

.slot:hover {
    background: $bg-hover;
    border: 1px $accent;
}

.slot-carried {
    layer: 2000;
}

.ee-busy {
    size: 14px 14px;
    tint: $accent;
}

/* ---- attributes ---- */

.ee-attributes { size: 100% fit; gap: 3px; }
.ee-attribute-row { size: 100% 26px; gap: 4px; align-items: start center; }
.ee-attribute-label {
    size: 0px fit;
    grow: 1;
    min-width: 0px;
    font-size: 9px;
    foreground: $text;
    wrap: false;
    text-overflow: dots;
}
.ee-attribute-value { size: 78px 22px; }
.ee-attribute-value .insp-input { size: 100% 22px; text-align: right; }
.ee-attribute-actions { size: 32px fit; gap: 4px; align-items: end center; }
.ee-attribute-tools { size: 100% fit; gap: 6px; align-items: start center; margin: 3px 0px; }
.ee-attribute-search { size: 0px 22px; grow: 1; min-width: 0px; }
.ee-attribute-tools .disabled { tint: $text-muted; opacity: 0.4; }
.ee-attribute-picker {
    size: 280px fit;
    gap: 4px;
    padding: 6px;
    background: $bg-panel;
    border: 1px $border;
    border-radius: $radius;
    shadow: 0px 3px 10px alpha(#000000, 0.4);
}
.ee-attribute-choices { size: 100% fit; max-height: 180px; gap: 1px; }
.ee-attribute-choice { size: 100% fit; min-height: 22px; padding: 4px 6px; border-radius: $radius-small; }
.ee-attribute-choice:hover { background: $bg-hover; }
.ee-attribute-choice-label { size: 100% fit; font-size: 9px; foreground: $text; wrap: false; text-overflow: dots; }
