/*
 * The notification stack in the bottom-right corner. Each card is bordered with its own kind's
 * gradient, matching the icon it carries; the rest follows the IDE's popups, compact and quiet, and
 * is set in the same code font as the IDE.
 */

@import "hollowengine:ui/styles/theme.hss";


.notif-stack {
    font-family: $font;
    font-size: $font-size;
    size: fit fit;
    gap: 6px;
    margin: 10px;
    align: end end;
}

.notif {
    size: 280px fit;
    gap: 5px;
    padding: 7px 8px 7px 10px;
    background: alpha($bg-field, 0.96);
    border-radius: $radius-large;
    border: 1px $divider;
    backdrop-filter: blur(8px);
    shadow: 0px 6px 16px 0px $shadow;
}

.notif.success { border: 1px linear-gradient(225deg, #9BF763, #3D5A24); }
.notif.error { border: 1px linear-gradient(225deg, #FF759F, #6E2020); }
.notif.warning { border: 1px linear-gradient(225deg, #F7C363, #6B4520); }
.notif.info { border: 1px linear-gradient(225deg, #4C86E0, #12203F); }
.notif.progress { border: 1px linear-gradient(225deg, #4C86E0, #12203F); }

.notif-head {
    size: 100% fit;
    gap: 8px;
    align-items: start center;
}

.notif-icon {
    size: 16px 16px;
}

.notif-title {
    size: fit fit;
    foreground: $text-strong;
    text-overflow: dots;
}

.notif-action {
    size: fit fit;
    min-height: 18px;
    padding: 2px 8px;
    background: $bg-hover;
    border-radius: $radius;
    hoverable: true;
    clickable: true;
    transition: background 120ms ease-out;
}

.notif-action:hover { background: $bg-pressed; }

.notif-action-label {
    align: center center;
    size: fit fit;
    foreground: $text-strong;
    wrap: false;
}

.notif-close {
    size: 16px 16px;
    padding: 4px;
    background: transparent;
    border-radius: $radius;
    tint: $text-faint;
    transition: tint 120ms ease-out, background 120ms ease-out;
}

.notif-close:hover {
    background: $bg-hover;
    tint: $text-strong;
}

.notif-track {
    size: 100% 3px;
    background: $bg-hover;
    border-radius: 2px;
    clip: true;
}

.notif-fill {
    background: linear-gradient(to bottom, #4C86E0, #9BC2FF);
    border-radius: 2px;
}

.notif.success .notif-fill { background: linear-gradient(to bottom, #70A832, #9BF763); }
.notif.error .notif-fill { background: linear-gradient(to bottom, #F54747, #FF759F); }
.notif.warning .notif-fill { background: linear-gradient(to bottom, #A86D32, #F7C363); }
