/* The dock: windows, tab bars, splitters and side stripes. Colors come from theme.hss. */

@import "hollowengine:ui/styles/theme.hss";


.dock-stack,
.dock-window,
.dock-content,
.dock-splitter {
    background: $bg-window;
}

.dock-tab {
    background: transparent;
    foreground: $text-muted;
    border-radius: $radius;
    align: start center;
    transition:
            background 120ms ease-out,
            foreground 120ms ease-out,
            translate 110ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animations: dock-tab-in 120ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes dock-tab-in {
    from { opacity: 0; scale: 0.92; }
    to   { opacity: 1; scale: 1; }
}

.dock-tab-indicator {
    background: transparent;
    transition: background 120ms ease-out;
}

.dock-tab.selected .dock-tab-indicator {
    background: $accent;
}

.dock-tab-icon {
    size: 12px 12px;
    margin-right: 5px;
}

.dock-tab-bar {
    scrollbar-overlay: true;
    scrollbar-side: start;
    scrollbar-thickness: 2px;
    scrollbar-margin: 0px;
    scrollbar-track: none;
    scrollbar-thumb: $scroll-thumb;
    scrollbar-thumb-hover: alpha($text-soft, 0.6);
    scrollbar-hover-thickness: 3px;
    scrollbar-thumb-radius: 1px;
}

.dock-tab:hover {
    background: $bg-panel;
    foreground: $text-strong;
}

.dock-tab.selected {
    background: $bg-panel;
    foreground: $caret;
}

.dock-tab:dragging {
    transition: none;
}

.dock-close-button {
    margin: 0px 4px 0px 2px;
    padding: 0px;
}

/* The cross stays faint until its tab is hovered or selected, and turns white only under the pointer. */
.dock-close-button .button-icon {
    size: 8px 8px;
    tint: $text-faint;
}

.dock-tab:hover .dock-close-button .button-icon,
.dock-tab.selected .dock-close-button .button-icon {
    tint: $text-soft;
}

.dock-tab .dock-close-button:hover .button-icon {
    tint: $white;
}

.dock-stripe {
    background: $bg-window;
    padding: 0px 0px;
    gap: 2px;
    transition: size 120ms ease-out;
}

.dock-stripe-button {
    border-radius: $radius;
    scale: 0.75;
    opacity: 0.6;
    transition:
            background 120ms ease-out,
            opacity 120ms ease-out,
            translate 110ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.dock-stripe-button:hover {
    background: $bg-hover;
    scale: 0.95;
    opacity: 1;
}

.dock-stripe-button.dragging {
    background: $bg-selected;
    scale: 1;
    opacity: 1;
}

.dock-stripe-button.selected {
    background: $bg-selected;
    opacity: 1;
}

.dock-stripe-icon {
    size: 12px 12px;
}

.dock-pinned-panel {
    background: $bg-window;
}

.dock-pinned-island {
    size: fill fill;
    margin: 2px;
    background: $bg-panel;
    border-radius: $radius-large;
    clip: true;
}

.dock-pinned-island .dock-content {
    background: none;
}

.dock-pinned-panel.sliding,
.dock-splitter.sliding {
    transition: size 120ms ease-out;
}

.dock-pinned-header {
    padding: 0px 4px 0px $panel-inset;
    gap: 6px;
}

.dock-pinned-header-icon {
    size: 12px 12px;
    tint: $text-soft;
}

.dock-pinned-header-label {
    foreground: $text-strong;
}

.dock-stripe-divider {
    margin: 3px 0px;
    background: $bg-hover;
}


.dock-drop-zone {
    padding: 3px;
    background: alpha($accent, 0.1);
    border: 1px alpha($accent, 0.32);
    border-radius: $radius;
    transition:
            background 100ms ease-out,
            border 100ms ease-out,
            scale 100ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animations: dock-drop-zone-in 110ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.dock-drop-zone.active {
    background: alpha($accent, 0.34);
    border: 1px alpha($accent, 0.95);
    scale: 1.08;
}

@keyframes dock-drop-zone-in {
    from { opacity: 0; scale: 0.85; }
    to   { opacity: 1; scale: 1; }
}

.dock-drop-zone-glyph {
    background: alpha($accent, 0.35);
    border-radius: 2px;
    transition: background 100ms ease-out;
}

.dock-drop-zone.active .dock-drop-zone-glyph {
    background: alpha($caret, 0.85);
}

.dock-drop-preview {
    background: alpha($accent, 0.14);
    border: 1px alpha($accent, 0.8);
    border-radius: $radius-large;
    opacity: 0;
    transition:
            translate 110ms cubic-bezier(0.2, 0.8, 0.2, 1),
            size 110ms cubic-bezier(0.2, 0.8, 0.2, 1),
            opacity 120ms ease-out;
    animations: dock-drop-preview-in 120ms ease-out;
}

.dock-drop-preview.visible {
    opacity: 1;
}

@keyframes dock-drop-preview-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.dock-content-body {
    animations: dock-content-in 150ms ease-out;
}

@keyframes dock-content-in {
    from { opacity: 0; translate: 0 4 0; }
    to   { opacity: 1; translate: 0 0 0; }
}
