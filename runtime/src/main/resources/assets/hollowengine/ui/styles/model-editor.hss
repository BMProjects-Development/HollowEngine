/* Styling for the model editor dock panel (client/ui/ide/panels/ModelEditorPanel.kt). Colors come
   from theme.hss. */

@import "hollowengine:ui/styles/theme.hss";


.model-editor-root {
    size: fill fill;
    gap: 6px;
}

.model-viewer-pane {
    grow: 1;
    size: 0px 100%;
    min-size: 0px 0px;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    clip: true;
}

.model-title {
    align: center start;
    margin: 8px;
    padding: 3px 9px;
    layer: 1000;
    foreground: $text;
    font-size: 11px;
    background: alpha($bg-field, 0.9);
    border-radius: $radius-large;
    border: 1px $bg-selected;
    wrap: false;
    backdrop-filter: blur(9px);
}

/* ---- toolbar (display toggles, stacked vertically) ---- */

.model-toolbar {
    align: start start;
    margin: 8px;
    gap: 5px;
    layer: 1000;
}

.model-chip {
    size: 28px 28px;
    align-items: center center;
    background: alpha($bg-raised, 0.82);
    border-radius: $radius-large;
    border: 1px $bg-selected;
    hoverable: true;
    clickable: true;
    transition: background 140ms ease-out, border 140ms ease-out;
    backdrop-filter: blur(9px);
}

.model-chip:hover {
    background: $bg-hover;
}

.model-chip.selected {
    background: $row-selected;
    border: 1px $accent;
}

.model-chip-icon {
    size: 16px 16px;
    tint: $text;
}

.model-chip-icon.selected {
    tint: $accent;
}

/* ---- animation control bar ---- */

.model-anim-bar {
    align: start end;
    margin: 10px;
    padding: 9px;
    gap: 7px;
    width: 300px;
    layer: 1000;
    background: $bg-raised;
    border-radius: $radius-large;
    border: 1px $bg-selected;
}

.model-anim-title {
    foreground: $text-muted;
    font-size: 10px;
    height: 13px;
}

.model-anim-controls {
    gap: 6px;
    width: 100%;
    align-items: start center;
}

.model-anim-dropdown {
    grow: 1;
    height: 26px;
    padding: 0px 8px;
    background: $bg-panel;
    border-radius: $radius-large;
    border: 1px $bg-selected;
}

.model-play {
    size: 26px 26px;
    border-radius: $radius-large;
}

.model-play .button-icon {
    size: 14px 14px;
}

.model-progress-track {
    width: 100%;
    height: 4px;
    background: $bg-panel;
    border-radius: 2px;
    clip: true;
}

.model-progress-fill {
    height: 100%;
    background: $accent;
    border-radius: 2px;
}

/* ---- splitter between preview and sidebar ---- */

.model-splitter {
    size: 5px 100%;
    background: transparent;
    border-radius: $radius-small;
    hoverable: true;
    transition: background 140ms ease-out;
}

.model-splitter:hover {
    background: $accent;
}

.model-splitter:dragging {
    background: $accent;
}

/* ---- sidebar (collapsible sections) ---- */

.model-sidebar {
    min-size: 190px 0px;
    gap: 4px;
    padding: 6px;
    background: $bg-raised;
    border-radius: $radius-large;
    border: 1px $bg-selected;
    clip: true;
}


.model-node-tree {
    width: 100%;
    height: 220px;
    min-size: 0px 0px;
}

/* The node-tree eye icon is a button: dim by default, accent on hover. */
.model-node-tree .tree-icon-button {
    tint: $text-muted;
    transition: tint 120ms ease-out;
}

.model-node-tree .tree-icon-button:hover {
    tint: $accent;
}

.model-anim-item {
    width: 100%;
    height: 22px;
    padding: 0px 8px;
    align-items: start center;
    background: transparent;
    foreground: $text-soft;
    border-radius: $radius;
    hoverable: true;
    clickable: true;
    transition:
        background 160ms ease-out,
        foreground 160ms ease-out;
}

.model-anim-item:hover {
    background: $bg-hover;
    foreground: $white;
}

.model-anim-item.selected {
    background: $row-selected;
    foreground: $white;
}

.model-empty {
    foreground: $border-strong;
    font-size: 11px;
    padding: 2px 4px;
}
.vanilla-model-error {
    max-width: 420px;
    height: fit;
    padding: 5px 8px;
    align: center end;
    foreground: $danger;
    background: alpha($bg-raised, 0.88);
    border: 1px alpha($danger, 0.45);
    border-radius: $radius;
}
