@import "hollowengine:ui/styles/theme.hss";

.dropdown-button {
    height: 24px;
    padding: 0px 8px;
    gap: 6px;
    foreground: $text;
    border-radius: $radius;
    transition:
        background 100ms ease-out,
        foreground 100ms ease-out;
}

.dropdown-button:hover {
    background: alpha($white, 0.08);
    foreground: $white;
}

.dropdown-button[expanded="true"] {
    background: alpha($white, 0.1);
    foreground: $white;
}

.dropdown-button[expanded="true"] .dropdown-button-arrow {
    rotate: 0px 0px 180px;
    stroke: $white;
}

.dropdown-button-icon,
.dropdown-item-icon {
    size: 14px 14px;
    tint: $white;
}

/* A row icon a little under the height of the row's text line, so folders do not crowd the names. */
.tree-icon {
    size: 13px 13px;
    tint: $white;
}

.dropdown-item-check {
    size: 10px 10px;
    checkbox-active: $accent;
    checkbox-mark: $white;
    border: 1px $border;
}

/* Fills the free space of a button wider than its text, so the arrow sits flush against the right edge. */
.dropdown-button-label {
    grow: 1;
    wrap: false;
}

/* The tree's chevron turned to point down, so every disclosure in the editor is the same two strokes. */
.dropdown-button-arrow {
    size: 10px 10px;
    shape: path("M 2 4 L 6 8 L 10 4", 12 12);
    fill: none;
    stroke: $text-muted;
    stroke-width: 1.5px;
    transition:
        rotate 120ms ease-out,
        stroke 120ms ease-out;
}

.dropdown-popup {
    min-width: 140px;
    padding: 3px;
    gap: 1px;
    align-items: stretch;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius-large;
    shadow: 0px 6px 16px 0px $shadow;
    @apply $thin-scroll;
}

.dropdown-item {
    width: 100%;
    gap: 6px;
    padding-vertical: 2px;
    padding-horizontal: 8px;
    border-radius: $radius;
    background: transparent;
    transition:
        background 80ms ease-out;
}

.dropdown-item-label {
    grow: 1;
}

.dropdown-item-shortcut {
    wrap: false;
    align: end center;
    margin-left: 18px;
    font-size: 10px;
    foreground: $text-muted;
}

.dropdown-separator {
    size: fill 1px;
    margin: 2px 6px;
    background: $bg-pressed;
}

.dropdown-item:hover {
    background: alpha($accent, 0.18);
}

.dropdown-item.open {
    background: alpha($accent, 0.18);
}

.dropdown-item.disabled {
    opacity: 0.42;
}

.tree-view {
    clip: true;
}

.tree-view-scroll {
    @apply $thin-scroll;
}

.tree-filter-row {
    width: 100%;
    height: 22px;
    margin-bottom: 3px;
    padding: 1px 4px;
    gap: 3px;
    align-items: start center;
    background: $bg-field;
    border-radius: $radius;
}

.tree-filter-icon, .tree-filter-close {
    size: 12px 12px;
    tint: $text-soft;
}

.tree-filter-input {
    min-height: 18px;
    padding: 2px;
    caret-color: $caret;
    selection-color: $selection;
}

.tree-filter-close:hover {
    tint: $white;
}

.tree-item {
    padding-right: 6px;
    background: transparent;
    foreground: $text-soft;
    border-radius: $radius-small;
    transition:
        background 200ms ease-out,
        foreground 200ms ease-out;
    animations: tree-row-in 110ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes tree-row-in {
    from { opacity: 0; translate: 0 -4 0; }
    to   { opacity: 1; translate: 0 0 0; }
}

.tree-item:hover {
    background: $bg-hover;
    foreground: $white;
}

.tree-item.selected {
    background: $row-selected;
    foreground: $white;
}

.tree-item.drop-target {
    background: alpha($accent, 0.55);
    foreground: $white;
}

.tree-item.drop-rejected {
    background: alpha($danger, 0.35);
}

.tree-indent-space {
    size: 16px 100%;
}

.tree-indent {
    size: 16px 100%;
    fill: none;
    stroke: $divider;
    stroke-width: 1px;
}

.tree-indent.line {
    shape: path("M 7.5 0 L 7.5 20", 16 20);
}

.tree-indent.end {
    shape: path("M 7.5 0 L 7.5 10", 16 20);
}

.tree-indent.branch {
    shape: path("M 7.5 0 L 7.5 20 M 7.5 6 Q 7.5 10 11.5 10 L 15 10", 16 20);
}

.tree-indent.last {
    shape: path("M 7.5 0 L 7.5 6 Q 7.5 10 11.5 10 L 15 10", 16 20);
}

.tree-expander {
    size: 12px 12px;
    margin: 0px 2px;
    shape: path("M 3 2 L 8 6 L 3 10", 12 12);
    fill: none;
    stroke: $text-muted;
    stroke-width: 1.5px;
    transition:
        rotate 120ms ease-out,
        fill 100ms ease-out;
}

.tree-expander[expanded="false"] {
    rotate: 0px 0px 0px;
}

.tree-expander[expanded="true"] {
    rotate: 0px 0px 90px;
}

.tree-expander-empty {
    size: 12px 12px;
    margin: 0px 2px;
}

.tree-label {
    height: fit;
    margin-left: 4px;
    align: start center;
    wrap: false;
}

.text-field {
    padding: 4px 3px;
    min-height: 18px;
}

.code-editor {
    padding: 8px;
    caret-color: $caret;
    selection-color: $selection;
    line-numbers: true;
    line-number-color: $text-faint;
    @apply $thin-scroll;
}

.editable-text-field-gutter {
    background: $bg-field;
}

.editable-text-field-inlay {
    height: fit;
    padding: 0px 1px;
    gap: 3px;
    align-items: start center;
    background: $bg-panel;
}

.editable-text-field-inlay-text {
    font-size: 70%;
    foreground: $text-faint;
    text-wrap: false;
    padding: 0px 2px;
}

.editable-text-field-inlay-icon {
    size: 12px 12px;
    align-y: center;
    tint: $text-faint;
}

.overlay-scrim {
    background: alpha(#000000, 0.46);
    backdrop-filter: blur(8px);
    animations: overlay-scrim-in 140ms ease-out both;
}

@keyframes overlay-scrim-in {
    from { opacity: 0; }
    to   { opacity: 1; }
}

.ui-tooltip {
    max-width: 260px;
    padding: 3px 7px;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius;
    shadow: 0px 4px 12px 0px $shadow;
}

.ui-tooltip-label {
    foreground: $text-strong;
}

/* An item's own tooltip: the game's lines, so vanilla's font and frame, with the IDE's corners. */
.ui-tooltip.item {
    max-width: 320px;
    padding: 3px 5px;
    background: alpha(#100010, 0.94);
    border: 1px linear-gradient(180deg, alpha(#5000FF, 0.5), alpha(#28007F, 0.5));
    border-radius: $radius-small;
}

.ui-item-tooltip {
    gap: 2px;
    font-family: vanilla;
    font-size: 8px;
}

.ui-item-tooltip-line {
    size: fit fit;
    foreground: #FFFFFF;
    text-wrap: false;
}

.ide-quick-fix-popup {
    padding: 3px;
    gap: 1px;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius-large;
    shadow: 0px 6px 16px 0px $shadow;
}

.ide-quick-fix-row {
    width: 100%;
    height: fit;
    min-height: 18px;
    padding: 2px 8px;
    border-radius: $radius;
    foreground: $text-strong;
    text-wrap: false;
}

.ide-quick-fix-row.selected {
    background: alpha($accent, 0.24);
}

.ide-quick-fix-row:hover {
    background: alpha($accent, 0.18);
}

.ide-quick-fix-label {
    text-wrap: false;
}

.editable-text-field-inlay-swatch {
    size: 8px 8px;
    border-radius: 2px;
}

.ide-completion-popup {
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius-large;
    shadow: 0px 6px 16px 0px $shadow;
    clip: true;
}

.ide-completion-divider {
    background: $bg-hover;
}

.ide-completion-list {
    size: 100% 100%;
    text-wrap: false;
    @apply $thin-scroll;
}

.ide-completion-hint {
    width: 100%;
    padding: 0px 8px;
    gap: 5px;
    align-items: start center;
    font-size: 85%;
    foreground: $text-faint;
}

.ide-completion-hint-icon {
    size: 10px 10px;
    tint: $text-faint;
}

.ide-completion-hint-key {
    foreground: $text-soft;
}

.ide-completion-row {
    width: 100%;
    padding: 0px 8px;
    gap: 6px;
    align-items: start center;
    text-wrap: false;
    clip: true;
}

.ide-completion-row:hover {
    background: alpha($white, 0.05);
}

.ide-completion-row.selected {
    background: alpha($accent, 0.24);
}

.ide-completion-row.selected:hover {
    background: alpha($accent, 0.3);
}

.ide-completion-icon {
    size: 12px 12px;
    tint: alpha($text-soft, 0.9);
}

.ide-completion-item {
    size: 14px 14px;
}

.ide-completion-main {
    grow: 1;
    clip: true;
    align-items: start center;
}

.ide-completion-text {
    gap: 0px;
    align-items: start center;
}

.ide-completion-label {
    foreground: $text-strong;
    text-wrap: false;
}

.ide-completion-detail {
    foreground: alpha($text-soft, 0.88);
    text-wrap: false;
}

.ide-completion-tail {
    foreground: $text-faint;
    text-wrap: false;
    align: end center;
}

.ide-code-insight-popup {
    padding: 6px 8px;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius-large;
    shadow: 0px 6px 16px 0px $shadow;
}

.ide-active-parameter {
    background: alpha($accent, 0.24);
    border-radius: 2px;
}

.ide-hover-documentation {
    foreground: $text-soft;
}

.ide-diagnostic-tooltip {
    padding: 5px 8px;
    align-items: start center;
    background: $bg-raised;
    border: 1px $border;
    border-radius: $radius-large;
    shadow: 0px 6px 16px 0px $shadow;
    clip: false;
}

.ide-diagnostic-tooltip.error {
    border: 1px alpha($danger, 0.55);
}

.ide-diagnostic-tooltip.warning {
    border: 1px alpha($warning, 0.5);
}

.ide-diagnostic-tooltip.info {
    border: 1px alpha($accent, 0.5);
}

/* Its size is the editor's, set in code. */
.ide-diagnostic-tooltip-message {
    foreground: $text-strong;
    text-wrap: true;
}

.timeline-keyframe-visual {
    scale: 1;
    stroke: $bg-window;
    stroke-width: 1px;
    shadow: 0px 0px 2px 0px alpha($accent, 0.28);
    transition:
        scale 160ms ease-out,
        stroke 160ms ease-out,
        shadow 160ms ease-out;
}

.timeline-keyframe:hover .timeline-keyframe-visual {
    scale: 1.12;
    stroke: $text-strong;
    shadow: 0px 0px 3px 0px alpha($accent, 0.48);
}

.timeline-keyframe.selected .timeline-keyframe-visual {
    scale: 1.12;
    stroke: $white;
    shadow: 0px 0px 4px 0px alpha($accent, 0.72);
}
