#ide-root {
    background: none;
}

.project-tree-panel.drop-target {
    background: rgba(88, 123, 174, 0.20);
}

#ide-toolbar {
    size: 100% fit;
    gap: 2px;
    background: #24272E;
}

#ide-logo {
    size: 24px 24px;
    align-items: center center;
    border-radius: 4px;
    rotate: 0 0 0;
    scale: 0.9;
    transition: all 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

#ide-logo:hover {
    rotate: 0 0 360;
    scale: 1.2;
}

.ide-toolbar-divider {
    size: 1px 14px;
    margin: 0px 6px;
    background: #3a3f4b;
}

.ide-toolbar-group {
    padding: 1px;
    gap: 1px;
    background: #1E2127;
    border-radius: 4px;
}

.ide-toolbar-button {
    size: 22px 22px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.ide-toolbar-button:hover {
    background: #414653;
}

.ide-toolbar-button.active {
    background: rgba(67, 106, 154, 0.62);
}

.ide-toolbar-button-icon {
    size: 13px 13px;
    tint: #aeb8ca;
    transition: all 110ms ease-out;
}

.ide-toolbar-button:hover .ide-toolbar-button-icon,
.ide-toolbar-button.active .ide-toolbar-button-icon {
    tint: #ffffff;
}

.ide-panel, .ide-empty-editor, .ide-editor-shell {
    size: fill fill;
    margin: 2px;
    padding: 4px;
    border-radius: 4px;
    gap: 6px;
    background: #24272E;
}

.ide-empty-editor {
    align-items: center center;
}

.project-filter-row {
    size: fill fit;
    padding: 0px 4px;
    gap: 4px;
    align-items: start center;
    background: #31343D;
    border-radius: 4px;
}

.project-filter-icon {
    size: 14px 14px;
    tint: #FFFFFF;
}

.project-filter {
    grow: 1;
    margin-top: 2px;
    align: center center;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-empty-title {
    foreground: #cbd3df;
    height: 18px;
}

.ide-status {
    height: 16px;
    margin-right: 6px;
    max-width: 360px;
    wrap: false;
    text-overflow: dots;
    font-size: 10px;
    foreground: #8f9bad;
}

.ide-empty-editor .ide-status {
    font-size: 11px;
}

.ide-shortcuts-dialog {
    padding: 12px;
}

.ide-shortcuts-content {
    gap: 3px;
    padding: 0px 8px 0px 0px;
    scrollbar: 6px;
    scrollbar-thumb: rgba(155, 169, 194, 0.42);
    scrollbar-thumb-radius: 3px;
}

.ide-shortcuts-title {
    margin-bottom: 4px;
    font-size: 14px;
    foreground: #F0F3F8;
}

.ide-shortcuts-group {
    margin-top: 6px;
    font-size: 10px;
    foreground: #8f9bad;
}

.ide-shortcuts-row {
    min-height: 20px;
    padding: 0px 6px;
    gap: 12px;
    background: #2A2E36;
    border-radius: 3px;
}

.ide-shortcuts-description {
    width: 0px;
    foreground: #d7deea;
}

.ide-shortcuts-keys {
    wrap: false;
    padding: 1px 5px;
    font-size: 10px;
    foreground: #F0F3F8;
    background: #3A3F49;
    border: 1px #4b5362;
    border-radius: 3px;
}

.ui-profiler-panel {
    gap: 4px;
}

.ui-profiler-toolbar {
    width: 100%;
    height: fit;
    gap: 4px;
}

.ui-profiler-button {
    width: fit;
    height: fit;
    padding: 3px 8px;
    background: #31343D;
    border-radius: 3px;
    foreground: #d7deea;
}

.ui-profiler-button:hover {
    background: #414653;
}

.ui-profiler-scroll {
    width: 100%;
    background: #1d2026;
    padding: 6px;
}

.ui-profiler-report {
    width: fit;
    height: fit;
    white-space: pre;
    font-size: 10px;
    foreground: #d7deea;
}

.console-panel {
    gap: 4px;
}

.console-toolbar {
    size: fit 22px;
    padding: 0px 3px;
    gap: 5px;
    align-items: start center;
}

.console-level-dropdown {
    min-width: 64px;
    height: 18px;
    padding: 0px 6px;
    background: #24272E;
    border-radius: 3px;
}

.console-mode-dropdown {
    min-width: 84px;
    height: 20px;
    padding: 0px 6px;
    background: #24272E;
    border-radius: 3px;
}

.console-command-row {
    width: 100%;
    height: fit;
    min-height: 26px;
    padding: 2px 4px;
    gap: 4px;
    background: #31343D;
    border-radius: 4px;
}

.console-filter, .console-command {
    padding: 2px 5px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

/* The whole log is one read-only field; its colours come from the console's own highlighter. */
.console-log {
    width: 100%;
    padding: 2px 6px;
    background: #1E2127;
    border-radius: 4px;
    foreground: #d7deea;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
    scrollbar: 6px;
    scrollbar-track: rgba(255, 255, 255, 0.03);
    scrollbar-thumb: rgba(155, 169, 194, 0.42);
    scrollbar-thumb-radius: 3px;
}

.console-empty {
    align-items: center center;
    background: #1E2127;
    border-radius: 4px;
    foreground: #7f8a9d;
}

.console-button {
    size: 22px 22px;
    border-radius: 3px;
    background: #414653;
    transition: background 110ms ease-out;
}

.console-button:hover {
    background: #5f6b80;
}

.console-button.disabled, .console-button.disabled:hover {
    background: #2a2d34;
}

.console-button-icon {
    size: 13px 13px;
    tint: #d7deea;
}

.console-button.disabled .console-button-icon {
    tint: #687588;
}

.project-context-menu {
    padding: 4px;
    gap: 1px;
}

.project-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.project-context-menu-icon {
    size: 14px 14px;
}

.project-context-menu-label {
    wrap: false;
}

.project-name-dialog {
    gap: 5px;
    padding: 5px;
}

.project-name-dialog-title {
    height: 18px;
    foreground: #d7deea;
}

.project-name-dialog-input {
    caret-color: #f0f6ff;
    background: #1E2127;
    border-radius: 4px;
    border: 1px #5F6677;
    selection-color: rgba(95, 140, 205, 0.46);
}

.project-name-dialog-actions {
    gap: 3px;
}

.project-actions {
    size: fit 20px;
    padding: 0px 3px;
    gap: 1px;
}

.project-action {
    size: 20px 20px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.project-action:hover {
    background: #414653;
}

.project-action-icon {
    size: 13px 13px;
    tint: #aeb8ca;
}

.project-action:hover .project-action-icon {
    tint: #ffffff;
}

.project-dialog-content {
    margin: 6px;
    gap: 7px;
}

.project-dialog-title {
    foreground: #F0F3F8;
    font-size: 14px;
}

.project-dialog-field {
    gap: 2px;
}

.project-dialog-scroll {
    gap: 7px;
    padding: 0px 8px 0px 0px;
    scrollbar: 6px;
    scrollbar-thumb: rgba(155, 169, 194, 0.42);
    scrollbar-thumb-radius: 3px;
}

.project-dialog-label {
    foreground: #8f9bad;
    font-size: 10px;
}

.project-dialog-input {
    padding: 2px 5px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.project-dialog-dropdown {
    height: 22px;
    padding: 0px 6px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
}

.project-dialog-dependencies {
    padding: 3px 5px;
    gap: 2px;
    background: #1E2127;
    border-radius: 3px;
    scrollbar: 6px;
    scrollbar-thumb: rgba(155, 169, 194, 0.42);
    scrollbar-thumb-radius: 3px;
}

.project-dialog-checkbox-row {
    gap: 7px;
    foreground: #D7DEEA;
}

.project-dialog-text {
    foreground: #D7DEEA;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-hint, .project-dialog-progress {
    foreground: #8f9bad;
    font-size: 10px;
    line-spacing: 2px;
}

.project-dialog-warning {
    foreground: #ffc266;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-error {
    foreground: #ff8787;
    font-size: 11px;
    line-spacing: 2px;
}

.project-dialog-path-row {
    gap: 6px;
}

.project-dialog-path {
    foreground: #aeb8ca;
    font-size: 10px;
}

.project-dialog-actions {
    gap: 6px;
    margin-top: 3px;
}

.project-dialog-button {
    min-width: 72px;
    padding: 0px 10px;
    border-radius: 4px;
    border: 1px #E7EBF2;
    background: #3A3F49;
    transition: background 80ms ease-out;
}

.project-dialog-button:hover {
    background: #4A515E;
}

.project-dialog-button.primary {
    background: #5F8CCD;
    foreground: #FFFFFF;
}

.project-dialog-button.primary:hover {
    background: #6E9BDC;
}

.project-dialog-button.disabled, .project-dialog-button.disabled:hover {
    background: #2C3038;
    foreground: #687588;
    border: 1px #4b5362;
}

.ide-hide-toolbar-dialog {
    padding: 12px;
}

.ide-hide-toolbar-dialog-content {
    gap: 10px;
}

.ide-hide-toolbar-dialog-title {
    foreground: #F0F3F8;
    font-size: 14px;
}

.ide-hide-toolbar-dialog-message {
    foreground: #B9C1CF;
    font-size: 11px;
    line-spacing: 2px;
}

.ide-hide-toolbar-dialog-checkbox-row {
    gap: 7px;
    foreground: #D7DEEA;
}

.ide-hide-toolbar-dialog-actions {
    gap: 6px;
}

.ide-hide-toolbar-dialog-button {
    border-radius: 4px;
    border: 1px #E7EBF2;
    background: #3A3F49;
    transition: background 80ms ease-out;
}

.ide-hide-toolbar-dialog-button:hover {
    background: #4A515E;
}

.ide-hide-toolbar-dialog-button:active {
    background: #303640;
}

.ide-hide-toolbar-dialog-button.primary {
    background: #5F8CCD;
    foreground: #FFFFFF;
}

.ide-hide-toolbar-dialog-button.primary:hover {
    background: #6E9BDC;
}

.ide-hide-toolbar-dialog-button.primary:active {
    background: #4D78B8;
}

.ide-editor-stack {
    size: 100% 100%;
}

.code-editor {
    line-spacing: 2px;
    inlay-hints: true;
}

/* Inlays are measured as they are drawn, so everything about their size lives here. */
.code-editor-inlay {
    height: fit;
    padding: 0px 3px;
    gap: 3px;
    align-items: center center;
    background: #1E1F22;
    margin-left: 2px;
    margin-right: 4px;
    border-radius: 3px;
}

.code-editor-inlay-text {
    /* A share of the code font, so the hints follow ctrl+wheel along with the text. */
    font-size: 85%;
    foreground: rgba(142, 153, 171, 0.9);
    text-wrap: false;
}

.code-editor-inlay-icon {
    size: 9px 9px;
    align-y: center;
    tint: rgba(142, 153, 171, 0.9);
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action {
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action:hover {
    background: #2B2D31;
}

.code-editor-inlay.inlay-action:hover .code-editor-inlay-icon {
    tint: #FFFFFF;
}

.code-editor-inlay.color-hint {
    padding: 1px;
    background: #00000000;
    margin-left: 0px;
    margin-right: 2px;
    border: 1px rgba(255, 255, 255, 0.22);
    border-radius: 3px;
}

.code-editor-inlay.color-hint:hover {
    background: #00000000;
    border: 1px #FFFFFF;
}

.code-editor-inlay-swatch {
    size: 8px 8px;
    border-radius: 2px;
}


.ide-find-bar {
    width: 100%;
    height: fit;
    gap: 3px;
    padding: 3px;
    background: #2A2E36;
    border: 1px #3a3f4b;
    border-radius: 4px;
}

.ide-find-row {
    width: 100%;
    height: fit;
    min-height: 22px;
    gap: 4px;
}

.ide-find-icon {
    size: 14px 14px;
    tint: #aeb8ca;
}

.ide-find-input {
    height: 20px;
    padding: 2px 5px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 3px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-find-toggle {
    size: 20px 20px;
    border-radius: 3px;
    foreground: #8f9bad;
    background: #00000000;
    transition: all 110ms ease-out;
}

.ide-find-toggle:hover {
    background: #414653;
}

.ide-find-toggle.on {
    background: rgba(67, 106, 154, 0.62);
    foreground: #f0f6ff;
}

.ide-find-toggle-label {
    wrap: false;
    font-size: 10px;
}

.ide-find-status {
    width: fit;
    min-width: 58px;
    wrap: false;
    foreground: #8f9bad;
}

.ide-find-status.empty {
    foreground: #ff8787;
}

.ide-find-button {
    size: 20px 20px;
    border-radius: 3px;
    background: #00000000;
    transition: background 110ms ease-out;
}

.ide-find-button:hover {
    background: #414653;
}

.ide-find-button-icon {
    size: 11px 11px;
    tint: #aeb8ca;
}

.ide-find-text-button {
    width: fit;
    height: 20px;
    padding: 0px 8px;
    background: #414653;
    foreground: #d7deea;
    border-radius: 3px;
}

.ide-find-text-button:hover {
    background: #5f6b80;
}


.ide-search-overlay {
    padding: 5px;
    gap: 4px;
    background: #24272E;
    border: 1px #5F6677;
    border-radius: 6px;
    shadow: 2px 4px 12px 0px rgba(0, 0, 0, 0.55);
}

.ide-search-scopes {
    width: 100%;
    height: fit;
    gap: 3px;
    align-items: start center;
}

.ide-search-scope {
    width: fit;
    height: 20px;
    padding: 0px 10px;
    border-radius: 3px;
    foreground: #8f9bad;
    background: #00000000;
    transition: all 110ms ease-out;
}

.ide-search-scope:hover {
    background: #414653;
}

.ide-search-scope.on {
    background: rgba(67, 106, 154, 0.62);
    foreground: #f0f6ff;
}

.ide-search-status {
    width: fit;
    wrap: false;
    foreground: #687588;
}

.ide-search-query-row {
    width: 100%;
    height: fit;
    gap: 5px;
    padding: 0px 4px;
    background: #1E2127;
    border: 1px #4b5362;
    border-radius: 4px;
}

.ide-search-icon {
    size: 14px 14px;
    tint: #aeb8ca;
}

.ide-search-input {
    height: 24px;
    caret-color: #f0f6ff;
    selection-color: rgba(95, 140, 205, 0.46);
}

.ide-search-results {
    width: 100%;
    max-height: 320px;
    gap: 1px;
    scrollbar: 6px;
    scrollbar-track: rgba(255, 255, 255, 0.03);
    scrollbar-thumb: rgba(155, 169, 194, 0.42);
    scrollbar-thumb-radius: 3px;
}

.ide-search-result {
    width: 100%;
    height: fit;
    min-height: 20px;
    padding: 2px 6px;
    gap: 6px;
    border-radius: 3px;
}

.ide-search-result:hover {
    background: rgba(84, 124, 176, 0.42);
}

.ide-search-result.selected {
    background: rgba(67, 106, 154, 0.62);
}

.ide-search-result-icon {
    size: 14px 14px;
}

.ide-search-result-name {
    width: fit;
    wrap: false;
    foreground: #d7deea;
}

.ide-search-result-detail {
    width: 0px;
    grow: 1;
    wrap: false;
    font-size: 10px;
    foreground: #687588;
}

.ide-search-result-match {
    foreground: #ffc266;
}

.ide-diagnostics-badge {
    height: fit;
    padding: 4px;
    align-items: center center;
    gap: 4px;
    background: #31343DBB;
    border: 1px rgba(255, 255, 255, 0.16);
    border-radius: 4px;
    shadow: 1px 2px 1px 0px rgba(0, 0, 0, 0.72);
    translate: 0 0 20px;
    foreground: #d7deea;
    transition: background 120ms ease-out, translate 120ms ease-out, shadow 120ms ease-out;
}

.ide-diagnostics-badge:hover {
    background: #31343D;
    translate: -1px -1px 20px;
    shadow: 2px 3px 1px 0px rgba(0, 0, 0, 0.72);
}

.ide-diagnostics-badge.has-errors {
    foreground: #ff8787;
}

.ide-diagnostics-badge.has-warnings {
    foreground: #ffc266;
}

.ide-diagnostics-text {
    translate: 0 1px 0;
}

.ide-diagnostics-wrap {
    width: 100%;
    background: #24272E;
    border-top: 1px #323846;
}

.ide-diagnostics-resizer {
    size: 100% 5px;
    background: #5F6677BB;
    transition: background 120ms ease-out;
}

.ide-diagnostics-resizer:hover {
    background: #5F6677;
}

.ide-diagnostics-header {
    width: 100%;
    padding: 3px 6px;
    gap: 6px;
    background: #2A2E36;
    border-bottom: 1px #323846;
}

.ide-diagnostics-title {
    foreground: #8f9bad;
    wrap: false;
}

.ide-diagnostics-panel {
    width: 100%;
    padding: 4px;
    gap: 2px;
}

.ide-diagnostic-copy {
    size: 16px 16px;
    border-radius: 3px;
    background: #00000000;
    transition: background 100ms ease-out;
}

.ide-diagnostic-copy:hover {
    background: #454B58;
}

.ide-diagnostic-copy-icon {
    size: 11px 11px;
    tint: #aeb8ca;
}

.ide-diagnostic-row {
    width: 100%;
    height: fit;
    padding: 4px 6px;
    gap: 8px;
    background: #31343D;
    border-radius: 3px;
}

.ide-diagnostic-severity {
    width: 68px;
    foreground: #8f9bad;
}

.ide-diagnostic-location {
    width: 54px;
    foreground: #8f9bad;
}

.ide-diagnostic-row.error .ide-diagnostic-severity {
    foreground: #ff8787;
}

.ide-diagnostic-row.warning .ide-diagnostic-severity {
    foreground: #ffc266;
}

.ide-diagnostic-row.info .ide-diagnostic-severity {
    foreground: #78a8ff;
}

.ide-diagnostic-message {
    width: 0px;
    grow: 1;
    foreground: #d7deea;
}

.file-context-menu {
    padding: 4px;
    gap: 1px;
}

.file-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.file-context-menu-icon {
    size: 14px 14px;
}

.file-context-menu-label {
    wrap: false;
}

.file-context-menu-separator {
    width: 100%;
    height: 1px;
    margin: 2px 0px;
    background: #3a3f4b;
}

.drag-ghost {
    width: fit;
    height: fit;
}

.drag-ghost-content {
    gap: 4px;
    padding: 2px 6px;
    background: #24272ECC;
    border: 1px #5F6677;
    border-radius: 4px;
    shadow: 1px 1px 3px 0px rgba(0, 0, 0, 0.42);
}

.drag-ghost-icon {
    size: 14px 14px;
}

.drag-ghost-label {
    wrap: false;
    foreground: #d7deea;
}
