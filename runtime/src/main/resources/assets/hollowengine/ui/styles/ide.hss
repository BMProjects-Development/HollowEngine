/*
 * The whole IDE is set in the code font, like its editor and its log: one face for every panel, tab,
 * menu and tooltip, narrower than the vanilla one and crisp at any size. Popups are not under
 * #ide-root, so they are named here too; this sheet is only loaded by the IDE, so the game's own
 * screens keep their font.
 *
 * Sizes: 9px for text, 8px for what is secondary, 11px for the title of a dialog.
 */

@import "hollowengine:ui/styles/theme.hss";

#ide-root,
.dropdown-popup,
.ui-tooltip,
.vfx-popup,
#cutscene-dialog {
    font-family: $font;
    font-size: $font-size;
}

.dropdown-popup .dropdown-item-shortcut {
    font-size: $font-size-small;
}

/* The vanilla drop shadow suits the pixel font only; under the code font it reads as a blur. */
.text-field {
    text-shadow: none;
}

#ide-root {
    background: none;
}

.project-tree-panel.drop-target {
    background: alpha($accent, 0.2);
}

#ide-toolbar {
    size: 100% fit;
    padding: 1px 0px;
    gap: 2px;
    background: $bg-window;
}

#ide-logo {
    size: $rail $rail;
    align-items: center center;
    border-radius: $radius;
    rotate: 0 0 0;
    scale: 0.9;
    transition: all 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

#ide-logo:hover {
    rotate: 0 0 360;
    scale: 1.2;
}

.ide-toolbar-divider {
    size: 1px 14px;
    margin: 0px 6px;
    background: $bg-hover;
}

.ide-toolbar-group {
    gap: 1px;
    background: $bg-panel;
    border-radius: $radius;
}

.ide-toolbar-button {
    size: fit fit;
    margin: 1px;
    padding: 4px;
    border-radius: $radius-small;
    background: transparent;
    transition: background 110ms ease-out;
}

.ide-toolbar-button:hover {
    background: $bg-hover;
}

.ide-toolbar-button.active {
    background: $bg-selected;
}

#ide-toolbar-search {
    size: $rail $rail;
    margin: 0px;
    padding: 5px;
}

.ide-toolbar-button-icon {
    size: 12px 12px;
    tint: $text-soft;
    transition: all 110ms ease-out;
}

.ide-toolbar-button:hover .ide-toolbar-button-icon,
.ide-toolbar-button.active .ide-toolbar-button-icon {
    tint: $white;
}

.ide-panel, .ide-empty-editor, .ide-editor-shell {
    size: fill fill;
    margin: 2px;
    padding: $panel-inset;
    border-radius: $radius-large;
    gap: 6px;
    background: $bg-panel;
}

.ide-editor-shell {
    padding: 2px;
    background: $bg-field;
}

.ide-empty-editor {
    align-items: center center;
    background: $bg-field;
}

/* The game sits in the editor area like any editor: a rounded panel inside the tab bar's stack. */
.game-viewport {
    size: fill fill;
    margin: 2px;
    border-radius: $radius-large;
    background: $bg-window;
}

.game-viewport-hint {
    foreground: $text-muted;
    text-align: center;
}

.project-filter-row {
    size: fill fit;
    padding: 0px 4px;
    gap: 4px;
    align-items: start center;
    background: $bg-field;
    border-radius: $radius;
}

.project-filter-icon {
    size: 14px 14px;
    tint: $white;
}

.project-filter {
    grow: 1;
    margin-top: 2px;
    align: center center;
    caret-color: $caret;
    selection-color: $selection;
}

.ide-empty-title {
    foreground: $text-muted;
    height: 18px;
}

/* The first breadcrumb's icon sits on the rail, under the stripe buttons. */
#ide-status-bar {
    padding: 0px 8px 0px 1px;
    gap: 12px;
    align-items: start center;
    background: $bg-window;
}

.ide-breadcrumbs {
    gap: 2px;
    align-items: start center;
}

.ide-breadcrumb {
    size: fit 16px;
    padding: 0px 4px;
    gap: 4px;
    align-items: start center;
    border-radius: $radius-small;
    background: transparent;
    foreground: $text-muted;
    transition:
            background 100ms ease-out,
            foreground 100ms ease-out;
}

.ide-breadcrumb.last {
    foreground: $text-strong;
}

.ide-breadcrumb.link:hover {
    background: $bg-hover;
    foreground: $caret;
}

.ide-breadcrumb-icon {
    size: 11px 11px;
}

.ide-breadcrumb-separator {
    size: 8px 8px;
    shape: path("M 3 1 L 6 4 L 3 7", 8 8);
    fill: none;
    stroke: $text-faint;
    stroke-width: 1px;
}

.ide-status-message {
    max-width: 360px;
    foreground: $text-soft;
}

.ide-status-detail {
    wrap: false;
    foreground: $text-muted;
}

.ide-status-detail.version {
    foreground: $text-faint;
}

.ide-shortcuts-dialog {
    padding: 12px;
}

.ide-shortcuts-content {
    gap: 3px;
    padding: 0px 8px 0px 0px;
    @apply $thin-scroll;
}

.ide-shortcuts-title {
    margin-bottom: 4px;
    font-size: $font-size-title;
    foreground: $caret;
}

.ide-shortcuts-group {
    margin-top: 6px;
    font-size: $font-size;
    foreground: $text-muted;
}

.ide-shortcuts-row {
    min-height: 20px;
    padding: 0px 6px;
    gap: 12px;
    background: $bg-hover;
    border-radius: $radius-small;
}

.ide-shortcuts-description {
    width: 0px;
    foreground: $text-strong;
}

.ide-shortcuts-keys {
    wrap: false;
    padding: 1px 5px;
    font-size: $font-size-small;
    foreground: $caret;
    background: $border;
    border: 1px $border;
    border-radius: $radius-small;
}

.ui-profiler-panel {
    gap: 4px;
}

.ui-profiler-toolbar {
    width: 100%;
    height: fit;
    gap: 4px;
}

.ui-profiler-button {
    width: fit;
    height: fit;
    padding: 3px 8px;
    background: $bg-selected;
    border-radius: $radius-small;
    foreground: $text-strong;
}

.ui-profiler-button:hover {
    background: $bg-pressed;
}

.ui-profiler-scroll {
    width: 100%;
    background: $bg-panel;
    padding: 6px;
}

.ui-profiler-report {
    width: fit;
    height: fit;
    white-space: pre;
    font-size: $font-size;
    foreground: $text-strong;
}

.tool-window-header {
    size: 100% 24px;
    padding: 0px 4px 0px 8px;
    gap: 2px;
    align-items: start center;
}

.tool-window-title {
    margin: 0px 8px 0px 4px;
}

.tool-window-tab {
    size: fit 18px;
    padding: 0px 8px;
    gap: 5px;
    align-items: center center;
    border-radius: $radius;
    background: transparent;
    foreground: $text-muted;
    transition:
            background 110ms ease-out,
            foreground 110ms ease-out;
}

.tool-window-tab:hover {
    background: $bg-hover;
    foreground: $text-strong;
}

.tool-window-tab.selected {
    background: $row-selected;
    foreground: $caret;
}

.tool-window-tab.selected:hover {
    background: $row-selected;
}

.tool-window-tab-count {
    min-width: 12px;
    padding: 2px 4px 0px 4px;
    text-align: center;
    border-radius: $radius-large;
    background: $bg-hover;
    foreground: $text-soft;
}

.tool-window-tab-count.has-errors {
    background: alpha($danger, 0.16);
    foreground: $danger;
}

.tool-window-tab-count.has-warnings {
    background: alpha($warning, 0.14);
    foreground: $warning;
}

.ide-panel.console-panel {
    padding: 0px;
    gap: 0px;
}

.console-toolbar {
    size: fit 22px;
    padding: 0px $panel-inset;
    gap: 5px;
    align-items: start center;
}

.console-level-dropdown {
    min-width: 64px;
    height: 18px;
    padding: 0px 6px;
}

.console-mode-dropdown {
    min-width: 84px;
    height: 20px;
    padding: 0px 6px;
    background: $bg-field;
    border: 1px $divider;
    border-radius: $radius;
}

.console-command-row {
    width: 100%;
    height: fit;
    min-height: 26px;
    padding: 3px 6px 5px 6px;
    gap: 4px;
}

.console-filter, .console-command {
    padding: 2px 5px;
    background: $bg-field;
    border: 1px $divider;
    border-radius: $radius;
    caret-color: $caret;
    selection-color: $selection;
}

/*
 * The whole log is one read-only field; its colors come from the console's own highlighter. It sits
 * a shade lighter than the header and the command line around it, like the editor does.
 */
.console-log {
    width: 100%;
    padding: 2px 8px;
    background: $bg-field;
    foreground: $text-strong;
    caret-color: $caret;
    selection-color: $selection;
    @apply $thin-scroll;
}

.console-empty, .problems-empty {
    align-items: center center;
    background: $bg-field;
    foreground: $text-faint;
}

.console-button {
    size: 22px 22px;
    border-radius: $radius;
    background: transparent;
    transition: background 110ms ease-out;
}

.console-button:hover {
    background: $bg-hover;
}

.console-button.disabled, .console-button.disabled:hover {
    background: transparent;
}

.console-button-icon {
    size: 13px 13px;
    tint: $text-strong;
}

.console-button.disabled .console-button-icon {
    tint: $text-faint;
}

.project-context-menu {
    padding: 4px;
    gap: 1px;
}

.project-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.project-context-menu-icon {
    size: 14px 14px;
}

.project-context-menu-label {
    wrap: false;
}

.project-name-dialog {
    gap: 5px;
    padding: 5px;
}

.project-name-dialog-title {
    height: 18px;
    foreground: $text-strong;
}

.project-name-dialog-input {
    caret-color: $caret;
    background: $bg-field;
    border-radius: $radius;
    border: 1px $border-strong;
    selection-color: $selection;
}

.project-name-dialog-actions {
    gap: 3px;
}

.panel-actions {
    size: fit 100%;
    padding: 0px 2px;
    gap: 1px;
    align-items: center center;
}

.panel-action {
    size: fit fit;
    margin: 2px 0px;
    padding: 3px;
    border-radius: $radius-small;
    background: transparent;
    transition: background 110ms ease-out;
}

.panel-action:hover {
    background: $bg-hover;
}

.panel-action-icon {
    size: 13px 13px;
    tint: $text-soft;
}

.panel-action:hover .panel-action-icon,
.panel-action.active .panel-action-icon {
    tint: $white;
}

/* A choice kept in a tool window's header, like the part of the level the scene lists. */
.dropdown-button.panel-dropdown {
    height: 20px;
    padding: 0px 6px;
    gap: 4px;
    font-size: $font-size-small;
}

.project-dialog-content {
    margin: 6px;
    gap: 7px;
}

.project-dialog-title {
    foreground: $caret;
    font-size: $font-size-title;
}

.project-dialog-field {
    gap: 2px;
}

.project-dialog-scroll {
    gap: 7px;
    padding: 0px 8px 0px 0px;
    @apply $thin-scroll;
}

.project-dialog-label {
    foreground: $text-muted;
    font-size: $font-size-small;
}

.project-dialog-input {
    padding: 2px 5px;
    background: $bg-field;
    border: 1px $border;
    border-radius: $radius-small;
    caret-color: $caret;
    selection-color: $selection;
}

.project-dialog-dropdown {
    height: 22px;
    padding: 0px 6px;
    background: $bg-field;
    border: 1px $border;
    border-radius: $radius-small;
}

.project-dialog-dependencies {
    padding: 3px 5px;
    gap: 2px;
    background: $bg-field;
    border-radius: $radius-small;
    @apply $thin-scroll;
}

.project-dialog-checkbox-row {
    gap: 7px;
    foreground: $text-strong;
}

.project-dialog-text {
    foreground: $text-strong;
    font-size: $font-size;
    line-spacing: 2px;
}

.project-dialog-hint, .project-dialog-progress {
    foreground: $text-muted;
    font-size: $font-size-small;
    line-spacing: 2px;
}

.project-dialog-warning {
    foreground: $warning;
    font-size: $font-size;
    line-spacing: 2px;
}

.project-dialog-error {
    foreground: $danger;
    font-size: $font-size;
    line-spacing: 2px;
}

.project-dialog-path-row {
    gap: 6px;
}

.project-dialog-path {
    foreground: $text-soft;
    font-size: $font-size-small;
}

.project-dialog-actions {
    gap: 6px;
    margin-top: 3px;
}

.project-dialog-button {
    min-width: 72px;
    padding: 0px 10px;
    border-radius: $radius;
    border: 1px $text-strong;
    background: $border;
    transition: background 80ms ease-out;
}

.project-dialog-button:hover {
    background: $bg-pressed;
}

.project-dialog-button.primary {
    background: $accent;
    foreground: $white;
}

.project-dialog-button.primary:hover {
    background: $accent;
}

.project-dialog-button.disabled, .project-dialog-button.disabled:hover {
    background: $bg-hover;
    foreground: $text-faint;
    border: 1px $border;
}

.ide-hide-toolbar-dialog {
    padding: 12px;
}

.ide-hide-toolbar-dialog-content {
    gap: 10px;
}

.ide-hide-toolbar-dialog-title {
    foreground: $caret;
    font-size: $font-size-title;
}

.ide-hide-toolbar-dialog-message {
    foreground: $text-soft;
    font-size: $font-size;
    line-spacing: 2px;
}

.ide-hide-toolbar-dialog-checkbox-row {
    gap: 7px;
    foreground: $text-strong;
}

.ide-hide-toolbar-dialog-actions {
    gap: 6px;
}

.ide-hide-toolbar-dialog-button {
    border-radius: $radius;
    border: 1px $text-strong;
    background: $border;
    transition: background 80ms ease-out;
}

.ide-hide-toolbar-dialog-button:hover {
    background: $bg-pressed;
}

.ide-hide-toolbar-dialog-button:active {
    background: $bg-selected;
}

.ide-hide-toolbar-dialog-button.primary {
    background: $accent;
    foreground: $white;
}

.ide-hide-toolbar-dialog-button.primary:hover {
    background: $accent;
}

.ide-hide-toolbar-dialog-button.primary:active {
    background: $accent;
}

.ide-editor-stack {
    size: 100% 100%;
}

.code-editor {
    line-spacing: 2px;
    inlay-hints: true;
}

/* Inlays are measured as they are drawn, so everything about their size lives here. */
.code-editor-inlay {
    height: fit;
    padding: 0px 3px;
    gap: 3px;
    align-items: center center;
    background: $bg-panel;
    margin-left: 2px;
    margin-right: 4px;
    border-radius: $radius-small;
}

.code-editor-inlay-text {
    /* A share of the code font, so the hints follow ctrl+wheel along with the text. */
    font-size: 85%;
    foreground: alpha($text-muted, 0.9);
    text-wrap: false;
}

.code-editor-inlay-icon {
    size: 9px 9px;
    align-y: center;
    tint: alpha($text-muted, 0.9);
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action {
    transition: all 170ms ease-in-out;
}

.code-editor-inlay.inlay-action:hover {
    background: $bg-hover;
}

.code-editor-inlay.inlay-action:hover .code-editor-inlay-icon {
    tint: $white;
}

.code-editor-inlay.color-hint {
    padding: 1px;
    background: transparent;
    margin-left: 0px;
    margin-right: 2px;
    border: 1px alpha($white, 0.22);
    border-radius: $radius-small;
}

.code-editor-inlay.color-hint:hover {
    background: transparent;
    border: 1px $white;
}

.code-editor-inlay-swatch {
    size: 8px 8px;
    border-radius: 2px;
}


.ide-find-bar {
    width: 100%;
    height: fit;
    gap: 3px;
    padding: 3px;
    background: $bg-panel;
    border-radius: $radius;
}

.ide-find-row {
    width: 100%;
    height: fit;
    min-height: 22px;
    gap: 4px;
}

.ide-find-icon {
    size: 14px 14px;
    tint: $text-soft;
}

.ide-find-input {
    height: 20px;
    padding: 2px 5px;
    background: $bg-field;
    border: 1px $divider;
    border-radius: $radius-small;
    caret-color: $caret;
    selection-color: $selection;
}

.ide-find-toggle {
    size: 20px 20px;
    border-radius: $radius-small;
    foreground: $text-muted;
    background: transparent;
    transition: all 110ms ease-out;
}

.ide-find-toggle:hover {
    background: $bg-pressed;
}

.ide-find-toggle.on {
    background: alpha($accent-fill-hover, 0.62);
    foreground: $caret;
}

.ide-find-toggle-label {
    wrap: false;
    font-size: $font-size-small;
}

.ide-find-status {
    width: fit;
    min-width: 58px;
    wrap: false;
    foreground: $text-muted;
}

.ide-find-status.empty {
    foreground: $danger;
}

.ide-find-button {
    size: 20px 20px;
    border-radius: $radius-small;
    background: transparent;
    transition: background 110ms ease-out;
}

.ide-find-button:hover {
    background: $bg-pressed;
}

.ide-find-button-icon {
    size: 11px 11px;
    tint: $text-soft;
}

.ide-find-text-button {
    width: fit;
    height: 20px;
    padding: 0px 8px;
    background: $border;
    foreground: $text-strong;
    border-radius: $radius-small;
}

.ide-find-text-button:hover {
    background: $bg-pressed;
}


.ide-search-overlay {
    padding: 5px;
    gap: 4px;
    background: $bg-raised;
    border: 1px $border-strong;
    border-radius: $radius-large;
    shadow: 2px 4px 12px 0px $shadow;
}

.ide-search-scopes {
    width: 100%;
    height: fit;
    gap: 3px;
    align-items: start center;
}

.ide-search-scope {
    width: fit;
    height: 20px;
    padding: 0px 10px;
    border-radius: $radius-small;
    foreground: $text-muted;
    background: transparent;
    transition: all 110ms ease-out;
}

.ide-search-scope:hover {
    background: $bg-pressed;
}

.ide-search-scope.on {
    background: alpha($accent-fill-hover, 0.62);
    foreground: $caret;
}

.ide-search-status {
    width: fit;
    wrap: false;
    foreground: $text-faint;
}

.ide-search-query-row {
    width: 100%;
    height: fit;
    gap: 5px;
    padding: 0px 4px;
    background: $bg-field;
    border: 1px $border;
    border-radius: $radius;
}

.ide-search-icon {
    size: 14px 14px;
    tint: $text-soft;
}

.ide-search-input {
    height: 24px;
    caret-color: $caret;
    selection-color: $selection;
}

.ide-search-results {
    width: 100%;
    max-height: 320px;
    gap: 1px;
    @apply $thin-scroll;
}

.ide-search-result {
    width: 100%;
    height: fit;
    min-height: 20px;
    padding: 2px 6px;
    gap: 6px;
    border-radius: $radius-small;
}

.ide-search-result:hover {
    background: $bg-hover;
}

.ide-search-result.selected {
    background: $row-selected;
}

.ide-search-result-icon {
    size: 14px 14px;
}

.ide-search-result-name {
    width: fit;
    wrap: false;
    foreground: $text-strong;
}

.ide-search-result-detail {
    width: 0px;
    grow: 1;
    wrap: false;
    font-size: $font-size-small;
    foreground: $text-faint;
}

.ide-search-result-match {
    foreground: $warning;
}

.ide-diagnostics-badge {
    height: fit;
    margin: 4px 10px 0px 0px;
    padding: 3px 5px;
    align-items: center center;
    gap: 4px;
    background: alpha($bg-panel, 0.88);
    border: 1px $divider;
    border-radius: $radius;
    translate: 0 0 20px;
    foreground: $text-strong;
    transition: background 120ms ease-out;
}

.ide-diagnostics-badge:hover {
    background: $bg-hover;
}

.problems-file {
    size: 100% 22px;
    padding: 0px 6px 0px 10px;
    gap: 5px;
    align-items: start center;
}

.problems-file-icon {
    size: 12px 12px;
}

.problems-file-name {
    margin-right: 4px;
    wrap: false;
    foreground: $text-strong;
}

.problem-count-icon {
    size: 9px 9px;
}

.problem-count {
    margin-right: 3px;
    foreground: $text-muted;
}

.problem-count.has-errors {
    foreground: $danger;
}

.problem-count.has-warnings {
    foreground: $warning;
}

.problems-list {
    padding: 2px 4px 4px 4px;
    background: $bg-field;
    @apply $thin-scroll;
}

.problem-row {
    size: 100% 20px;
    padding: 0px 4px 0px 22px;
    gap: 6px;
    align-items: start center;
    border-radius: $radius-small;
    background: transparent;
    transition: background 100ms ease-out;
}

.problem-row:hover {
    background: $bg-hover;
}

.problem-icon {
    size: 10px 10px;
}

.problem-message {
    width: 0px;
    grow: 1;
    foreground: $text-strong;
}

.problem-location {
    wrap: false;
    foreground: $text-faint;
}

.problem-copy {
    size: 16px 16px;
    border-radius: $radius-small;
    background: transparent;
    transition: background 100ms ease-out;
}

.problem-copy:hover {
    background: $bg-hover;
}

.problem-copy-icon {
    size: 10px 10px;
    tint: $text-faint;
}

.problem-row:hover .problem-copy-icon,
.problem-copy:hover .problem-copy-icon {
    tint: $text-strong;
}

.file-context-menu {
    padding: 4px;
    gap: 1px;
}

.file-context-menu-item {
    width: 100%;
    min-height: 18px;
    padding: 0px 5px;
}

.file-context-menu-icon {
    size: 14px 14px;
}

.file-context-menu-label {
    wrap: false;
}

.file-context-menu-separator {
    width: 100%;
    height: 1px;
    margin: 2px 0px;
    background: $border;
}

.drag-ghost {
    width: fit;
    height: fit;
}

.drag-ghost-content {
    gap: 4px;
    padding: 2px 6px;
    background: alpha($bg-raised, 0.8);
    border: 1px $border-strong;
    border-radius: $radius;
    shadow: 1px 1px 3px 0px $shadow;
}

.drag-ghost-icon {
    size: 14px 14px;
}

.drag-ghost-label {
    wrap: false;
    foreground: $text-strong;
}


.scene-hint {
    size: 100% fit;
    padding: 4px 6px;
    foreground: $text-faint;
    font-size: $font-size-small;
}

/* The scene window with nothing in it: the same dashed frame the inspector uses, in the middle. */
.scene-empty {
    size: 100% 100%;
    padding: 12px;
    align-items: center center;
}

.scene-empty-state {
    size: 100% fit;
    padding: 22px 12px 18px 12px;
    gap: 8px;
    align-items: center start;
    border: 1px $divider;
    border-dash: 5px 4px;
    border-radius: $radius-large;
}

.scene-empty-icon {
    size: 22px 22px;
    tint: $text-muted;
}

.scene-empty-text {
    size: 100% fit;
    text-align: center;
    foreground: $text-muted;
    font-size: $font-size;
}

.scene-empty-hint {
    size: 100% fit;
    text-align: center;
    foreground: $text-faint;
    font-size: $font-size-small;
}

/* Text / split / preview switch of a file with a preview, at the right end of its tab bar. */
.ide-view-modes {
    size: fit 100%;
    padding: 0px 2px;
    gap: 1px;
    align-items: center center;
}

.ide-view-mode {
    size: fit fit;
    margin: 2px 0px;
    padding: 3px;
    border-radius: $radius-small;
    background: transparent;
    transition: background 110ms ease-out;
}

.ide-view-mode:hover {
    background: $bg-hover;
}

.ide-view-mode.selected {
    background: $bg-selected;
}

.ide-view-mode-icon {
    size: 13px 13px;
    tint: $text-soft;
}

.ide-view-mode:hover .ide-view-mode-icon,
.ide-view-mode.selected .ide-view-mode-icon {
    tint: $white;
}

.ide-preview-divider {
    background: transparent;
    transition: background 120ms ease-out;
}

.ide-preview-divider:hover {
    background: $accent-soft;
}

.ide-preview-error {
    size: fill fill;
    margin: 2px;
    padding: 12px;
    gap: 6px;
    border-radius: $radius-large;
    background: $bg-panel;
}

.ide-preview-error-title {
    height: fit;
    foreground: $caret;
    font-size: $font-size-title;
}

.ide-preview-error-message {
    size: 100% fit;
    foreground: $danger;
    text-wrap: true;
}

/* A file's visual editor or preview: the same rounded panel the text editor sits in. */
.ide-file-panel {
    size: fill fill;
    margin: 2px;
    border-radius: $radius-large;
    background: $bg-field;
}

/* Something drawn edge to edge inside a file panel, such as a 3D preview, rounded with it. */
.ide-file-viewport {
    border-radius: $radius-large;
}
