@file shaders/programs/composite1.glsl
replace "\n\t/* DRAWBUFFERS:0 */\n"
<<<

	#ifdef IRLITE_ACTIVE
	// IRLite backlight rim outline (LINEAR space - Solas colortex0 is HDR-linear here, no gamma encode).
	// Enable + target are live UBO values (vlC.w bit8, bits11-12); IRLITE_OUTLINE_TARGET is the unbound-UBO
	// fallback. depth / matrices / colortex3 come from the lib mirror-gate when the pack's VL/LPV_FOG/NETHER_SMOKE
	// block is compiled out. Reconstruct playerPos + derivative normal in UNIFORM control flow (dFdx/dFdy need it),
	// then gate only the additive ink.
	float irliteZ0 = texture2D(depthtex0, texCoord).r;
	vec3 irliteONdc = vec3(texCoord, irliteZ0) * 2.0 - 1.0;
	vec4 irliteOView = gbufferProjectionInverse * vec4(irliteONdc, 1.0);
	irliteOView /= irliteOView.w;
	vec3 irliteOPlayerPos = mat3(gbufferModelViewInverse) * irliteOView.xyz + gbufferModelViewInverse[3].xyz;
	vec3 irliteONormal = cross(dFdx(irliteOPlayerPos), dFdy(irliteOPlayerPos));
    vec2 irliteReplayData = texelFetch(colortex9, ivec2(gl_FragCoord.xy), 0).rg;
    uint irliteReplay = abs(irliteReplayData.y - (irliteZ0)) < 0.000002 ? uint(max(irliteReplayData.x, 0.0) + 0.5) : 0u;
	bool irliteODraw = irliteZ0 < 1.0 && irliteZ0 > 0.56;   // skip sky + hand
		float irliteOMat = texture2D(colortex3, texCoord).z; // Solas entity tag: entities write colortex3.z=0.25 (gbuffers_entities), terrain/blocks=0.0
		bool irliteOEntity = irliteOMat > 0.1;
	if (irliteODraw) {
		if (dot(irliteONormal, irliteOPlayerPos) > 0.0) irliteONormal = -irliteONormal;
		color += IRLITE_INTENSITY_LIVE * irlite_outlineInk(irliteOPlayerPos, irliteONormal, (irliteOEntity || irliteReplay > 0u), irliteReplay);
	}
	#endif

	#if defined IRLITE_ACTIVE && defined IRLITE_VOLUMETRIC
	// IRLite VL upsample (bilinear; colour is LINEAR here).
	color += texture2D(colortex10, texCoord).rgb;
	#endif

	/* DRAWBUFFERS:0 */

