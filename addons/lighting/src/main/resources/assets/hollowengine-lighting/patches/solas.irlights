@file shaders/lib/lighting/gbuffersLighting.glsl
replace "    vec3 finalColor = diffuseAlbedo + specularHighlight * vanillaDiffuse;\n\n    albedo.rgb = pow(max(finalColor, vec3(0.0)), vec3(1.0 / 2.2));\n"
<<<
    vec3 finalColor = diffuseAlbedo + specularHighlight * vanillaDiffuse;

    #ifdef IRLITE_ACTIVE
    // IRLite: entity flag is compile-time via the pack's own line-1 program self-defines. The diffuse/specular
    // enables and both intensities are live UBO values (see IRLITE_SURFACE_OK).
    #if defined GBUFFERS_ENTITIES || defined GBUFFERS_BLOCK || defined GBUFFERS_HAND
    bool irliteNonTerrain = true;
    #else
    bool irliteNonTerrain = false;
    #endif
    vec3 irliteDiffuse, irliteSpec;
    irlite_lightSurface(worldPos, newNormal, viewPos, (irliteNonTerrain || irlite_replayId > 0), uint(max(irlite_replayId, 0)), irliteDiffuse, irliteSpec);
    finalColor += albedo.rgb * (1.0 - metalness) * (IRLITE_INTENSITY_LIVE * irliteDiffuse);
    finalColor += (IRLITE_INTENSITY_LIVE * IRLITE_SPECULAR_INTENSITY_LIVE) * irliteSpec;
    #endif

    albedo.rgb = pow(max(finalColor, vec3(0.0)), vec3(1.0 / 2.2));

