@file shaders/shaders.properties
replace "program.world-1/shadowcomp.enabled=VX_SUPPORT\nprogram.world1/shadowcomp.enabled=VX_SUPPORT"
<<<
program.world-1/shadowcomp.enabled=VX_SUPPORT
program.world1/shadowcomp.enabled=VX_SUPPORT
program.world0/deferred2.enabled=IRLITE_VOLUMETRIC
program.world-1/deferred2.enabled=IRLITE_VOLUMETRIC
program.world1/deferred2.enabled=IRLITE_VOLUMETRIC

#IRLite reduced-res volumetric buffer (deferred2 march, composite1 upsample)
size.buffer.colortex10=IRLITE_VL_RESOLUTION IRLITE_VL_RESOLUTION

# IRLite replay attachment: replace the tag even on translucent draws.
blend.gbuffers_armor_glint.colortex9=off
blend.gbuffers_basic.colortex9=off
blend.gbuffers_beaconbeam.colortex9=off
blend.gbuffers_block.colortex9=off
blend.gbuffers_block_translucent.colortex9=off
blend.gbuffers_clouds.colortex9=off
blend.gbuffers_damagedblock.colortex9=off
blend.gbuffers_entities.colortex9=off
blend.gbuffers_entities_glowing.colortex9=off
blend.gbuffers_entities_translucent.colortex9=off
blend.gbuffers_hand.colortex9=off
blend.gbuffers_hand_water.colortex9=off
blend.gbuffers_line.colortex9=off
blend.gbuffers_spidereyes.colortex9=off
blend.gbuffers_terrain.colortex9=off
blend.gbuffers_textured.colortex9=off
blend.gbuffers_textured_lit.colortex9=off
blend.gbuffers_water.colortex9=off
blend.gbuffers_weather.colortex9=off

