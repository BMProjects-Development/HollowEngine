@import "hollowengine:ui/styles/theme.hss";

.gn-pin.gn-type-flow { border-radius: 2px; }

.graph-node.gn-reroute.gn-type-flow { background: #E6E8EE; border-radius: 2px; }

.gn-pin-label.optional {
    foreground: $text-faint;
}

.gn-field.error, .insp-input.error {
    border-color: $danger;
}

.gn-field.warning {
    border-color: $warning;
}

.st-vector {
    gap: 3px;
}

.st-vector-menu {
    size: 10px 10px;
}

.st-row-button {
    size: 12px 12px;
    cursor: hand;
    opacity: 0.6;
    transition: opacity 110ms ease-out;
}

.st-row-button:hover {
    opacity: 1;
}

.st-row-add {
    gap: 4px;
    cursor: hand;
}

.st-scope-back {
    padding: 6px;
    align-items: center center;
    background: $bg-raised;
    border-radius: $radius;
    cursor: hand;
    transition: background 110ms ease-out;
}

.st-scope-back:hover {
    background: $bg-hover;
}

.st-scope-back-icon {
    size: $icon $icon;
}

$section-head: #303237;
$section-body: #2A2B2F;

.st-section {
    gap: 6px;
    cursor: hand;
    background: $section-head;
    border-radius: $radius;
    transition: background 110ms ease-out;
}

.st-section.open {
    border-radius: 0px;
}

.st-section:hover {
    background: $bg-pressed;
}

.st-nested {
    background: $section-body;
}

.st-section-title {
    foreground: $text-soft;
}
