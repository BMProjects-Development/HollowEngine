#dialogue-root {
    size: fill fill;
    align-items: center center;
}

#advance-catcher {
    size: fill fill;
    align: center center;
}

#line-panel {
    size: fit fit;
    width: 32%;
    max-width: 306px;
    margin: 0px 0px 28px 0px;
    align: center end;
    align-items: start start;

    animations: line-in 220ms ease-out both;
}

@keyframes line-in {
    from { opacity: 0; translate: 0 8 0; }
    to   { opacity: 1; translate: 0 0 0; }
}

#line-box {
    size: fill fit;
    min-height: 36px;
    align-items: start start;
    gap: 7px;
    padding: 7px;

    background: rgba(8, 9, 12, 0.62);
    backdrop-filter: blur(12px);
    border: 1px #ffffff;
    border-radius: 2px;
}

#speaker {
    size: fit fit;
    gap: 3px;
    align-items: center start;
}

.speaker-name {
    font-size: 7px;
    color: #ffffff;
    text-wrap: false;
}

.speaker-text {
    color: #ffffff;
    text-effects: pulse, outline(0.5px, #379cde88);
}

#portrait-frame {
    size: 30px 30px;
    clip: true;
    align-items: center start;
    background: rgba(255, 255, 255, 0.06);
    border: 1px rgba(255, 255, 255, 0.45);
    border-radius: 2px;
}

#portrait {
    size: 30px 60px;
    align: center start;
    margin-top: 7px;
    rotate-y: -20;
}

.line-text {
    size: fill fit;
    grow: 1;
    font-size: 7px;
    color: #f2f2f2;
    line-spacing: 2px;
    text-wrap: true;
}

.line-text-pending {
    opacity: 0;
}

#advance-hint {
    size: 16px 16px;
    align: end end;
    margin: 0px -8px -8px 0px;
    align-items: center center;

    background: rgba(8, 9, 12, 0.82);
    border: 1px #ffffff;
    border-radius: 2px;
    input-transparent: true;

    opacity: 0;
    transitions: opacity 160ms ease-out;
}

#advance-hint-icon {
    size: 8px 11px;
    image-fit: contain;
    input-transparent: true;
}

#advance-hint:ready {
    opacity: 1;
    animations: hint-float 1600ms ease-in-out infinite;
}

@keyframes hint-float {
    0%   { translate: 0 0 0; }
    50%  { translate: 0 -2 0; }
    100% { translate: 0 0 0; }
}

#choice-window {
    size: fit fit;
    min-width: 146px;
    align: center center;
    align-items: stretch start;
    gap: 4px;
    padding: 8px;

    background: rgba(8, 9, 12, 0.68);
    backdrop-filter: blur(14px);
    border: 1px #ffffff;
    border-radius: 2px;

    animations: line-in 200ms ease-out both;
}

.choice {
    size: fill fit;
    padding: 4px 7px 4px 7px;
    align-items: center start;

    background: rgba(255, 255, 255, 0.05);
    border: 1px rgba(255, 255, 255, 0.35);
    border-radius: 2px;
    cursor: pointer;

    transitions:
        background 110ms ease-out,
        translate 110ms ease-out,
        opacity 160ms ease-out,
        filter 160ms ease-out;
}

.choice-text {
    font-size: 7px;
    color: #e8e8e8;
    text-wrap: false;
}

.choice:hover {
    background: rgba(255, 255, 255, 0.16);
    translate: 3 0 0;
}

.choice:hover .choice-text {
    color: #ffffff;
}

.choice:selected {
    background: rgba(255, 255, 255, 0.22);
}

.choice:disabled {
    filter: grayscale(1);
    opacity: 0.5;
}
